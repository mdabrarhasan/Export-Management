<script src="~/customjs/PackingReqConfirm.js"></script>
<script src="~/customjs/common.js"></script>


<div ng-app="App" ng-controller="Ctl">

    <div ng-show="loading">
        <img style="width:50%;height:100%;position:absolute;z-index:1;" src="~/assets/images/Untitled.svg">
    </div>

    <div class="row"> 
        <div class="col-sm-12">
            <div class="card">

                <!-- HEADER -->
                <div class="card-header">
                    <h4>Invoice</h4>
                </div>

                <div class="card-body" style="font-family:'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; font-size:14px;">

                    <!-- TOP CONTROLS -->
                    <div class="row align-items-center mb-3">

                        <!-- ADD BUTTON -->
                        <div class="col-md-4 d-flex align-items-center">
                            @* <button type="button"
                                    
                                    class="btn btn-primary btn-sm d-inline-flex align-items-center gap-2 px-3 py-2 shadow-sm"
                                    ng-click="Clear()"
                                    data-bs-toggle="modal"
                                    data-bs-target="#exampleModalFullscreen">
                                <b>
                                    <i class="mdi mdi-plus"></i>
                                    <span>Add New</span>
                                </b>
                            </button> *@
                        </div>

                        <!-- MESSAGE / HIDDEN -->
                        <div class="col-md-4">
                            <input type="hidden" id="hpackinglineid" />
                            <p id="Msg" class="text-muted mb-0"></p>
                        </div>

                        <!-- SEARCH -->
                        <div class="col-md-4">
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="mdi mdi-magnify"></i>
                                </span>

                                <input type="text"
                                       ng-model="search"
                                       class="form-control"
                                       placeholder="Search Packing, PI/SC, Customer...">

                                <button class="btn btn-outline-secondary"
                                        type="button"
                                        ng-click="search=''"
                                        ng-show="search">
                                    <i class="mdi mdi-close"></i>
                                </button>
                            </div>
                        </div>

                    </div>

                    <!-- TABLE -->
                    <div class="table-responsive">
                        <table class="table table-bordered table-hover" ng-init="GetAllData()">

                            <thead class="table-dark">
                                <tr>
                                    <th style="display:none;">ID</th>
                                    <th ng-click='sortBy("invoiceno")'>Invoice No</th>
                                    <th ng-click='sortBy("pickpacknumber")'>Packing No</th>
                                    <th ng-click='sortBy("pickpackdate")'>Packing Date</th>
                                    <th ng-click='sortBy("packreqnumber")'>Req No</th>
                                    <th ng-click='sortBy("piscnumber")'>PI / SC</th>
                                    <th ng-click='sortBy("customername")'>Customer</th>
                                    <th ng-click='sortBy("packreqdate")'>Req Date</th>
                                    <th ng-click='sortBy("currency")'>Currency</th>
                                    <th ng-click='sortBy("documentcreateddate")'>Created</th>

                                    <th>Status</th>
                                    <th class="text-center" style="width:260px;">Action</th>
                                </tr>
                            </thead>

                            <tbody>
                                <tr dir-paginate="list in getalldata | orderBy:sortColumn:reverse | filter:search | itemsPerPage:pageSize"
                                    current-page="currentPage">

                                    <td style="display:none;">{{list.id}}</td>

                                    <td>{{list.invoiceno}}</td>

                                    <td>
                                        <a href="" ng-click="Report(list.pickpacknumber)">
                                            {{list.pickpacknumber}}
                                        </a>
                                    </td>

                                    <td>{{list.pickpackdate}}</td>
                                    <td>{{list.packreqnumber}}</td>
                                    <td>{{list.piscnumber}}</td>
                                    <td>{{list.customername}}</td>
                                    <td>{{list.packreqdate}}</td>
                                    <td>{{list.currency}}</td>
                                    <td>{{list.documentcreateddate}}</td>

                                    <!-- STATUS -->
                                    <td>
                                        <span class="badge rounded-pill badge-soft-info" ng-if='list.code=="PEND"'>{{list.docstatus}}</span>
                                        <span class="badge rounded-pill badge-soft-success" ng-if='list.code=="APPR"'>{{list.docstatus}}</span>
                                        <span class="badge rounded-pill badge-soft-danger" ng-if='list.code=="REJC"'>{{list.docstatus}}</span>
                                        <span class="badge rounded-pill badge-soft-primary" ng-if='list.code=="COMP"'>{{list.docstatus}}</span>
                                    </td>

                                    <!-- ACTION -->
                                    <td class="text-center">

                                        <button type="button"
                                                class="btn btn-info btn-sm"
                                                data-bs-toggle="modal"
                                                data-bs-target="#ViewEditexampleModalFullscreen"
                                                ng-click="ViewData(list.id)">
                                            <i class="fas fa-search-plus"></i>
                                        </button>

                                        <button type="button"
                                                class="btn btn-info btn-sm"
                                                ng-disabled='list.flag == 1'
                                                data-bs-toggle="modal"
                                                data-bs-target="#EditexampleModalFullscreen"
                                                ng-click="EditbyMasterID(list.id,list.agreementtypeid)">
                                            <i class="fa fa-edit"></i>
                                        </button>

                                        <button type="button"
                                                class="btn btn-danger btn-sm"
                                                ng-disabled='list.flag == 1'
                                                ng-hide='list.code == "COMP"'
                                                ng-click="DeleteMaster(list.id)">
                                            <i class="fa fa-trash"></i>
                                        </button>

                                        <button type="button"
                                                class="btn btn-success btn-sm"
                                                ng-show='list.code == "COMP"'
                                                ng-click="DelChallan(list.id)">
                                            <i class="fas fa-file-invoice"></i>
                                        </button>

                                        <button type="button"
                                                class="btn btn-secondary btn-sm"
                                                ng-show='list.code == "COMP"'
                                                ng-click="TrucChallan(list.id)">
                                            <i class="fas fa-truck"></i>
                                        </button>

                                    </td>

                                </tr>
                            </tbody>

                        </table>
                    </div>

                    <!-- PAGINATION INIT -->
                    <div ng-init="currentPage=1; pageSize=8"></div>

                    <!-- PAGINATION STYLE -->
                    <style>
                        dir-pagination-controls ul {
                            display: flex;
                            justify-content: center;
                            gap: 6px;
                            margin-top: 20px;
                            padding-left: 0;
                        }

                        dir-pagination-controls li {
                            list-style: none;
                        }

                            dir-pagination-controls li a {
                                padding: 8px 14px;
                                border-radius: 8px;
                                background: #f8f9fa;
                                color: #0d6efd;
                                transition: 0.25s;
                            }

                                dir-pagination-controls li a:hover {
                                    background: #e7f1ff;
                                }

                            dir-pagination-controls li.active a {
                                background: #0d6efd;
                                color: #fff;
                            }

                            dir-pagination-controls li.disabled a {
                                background: #e9ecef;
                                color: #adb5bd;
                            }
                    </style>

                    <!-- FOOTER -->
                    <div class="row mt-2 align-items-center">

                        <!-- TOTAL -->
                        <div class="col-md-4">
                            <span style="font-size:13px; font-weight:600; opacity:0.75;">
                                Total Records:
                                <b>{{ (getalldata | filter:search).length }}</b>
                            </span>
                        </div>

                        <!-- PAGINATION -->
                        <div class="col-md-4 text-center">
                            <dir-pagination-controls direction-links="true"
                                                     boundary-links="true"
                                                     current-page="currentPage">
                            </dir-pagination-controls>
                        </div>

                        <div class="col-md-4"></div>

                    </div>

                </div>
            </div>
        </div>
    </div>

