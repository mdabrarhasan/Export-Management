                        <h4>List of Item :</h4>
                        <style>
                            /* Compact row spacing for the edit modal item table */
                            #eemycontainer > tbody > tr > td {
                                padding-top: 0.9rem;
                                padding-bottom: 0.9rem;
                                vertical-align: middle;
                            }

                            /* Hide empty .error spans so they don't reserve vertical space.
                                   They will still appear when you toggle them on via validation. */
                            #eemycontainer .error:empty {
                                display: none;
                            }

                            /* If your .error class is always display:block, force inline-block
                                   and only show when it has the .show / .invalid trigger class */
                            #eemycontainer td .error {
                                display: none;
                                font-size: 11px;
                                line-height: 1;
                                margin-top: 2px;
                            }

                                #eemycontainer td .error.show {
                                    display: inline-block;
                                }

                            /* Ensure inputs inside the table don't add extra margin */
                            #eemycontainer td .form-control {
                                margin-bottom: 0;
                            }
                        </style>
