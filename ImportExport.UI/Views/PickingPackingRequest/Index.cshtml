                                                />
                                        <span class="error">Remaining Quantity required</span>
                                    </td>

                                    

                                   @*  <td>
                                        <input type="text" id="{{'epackingreqquantity'+$index}}" value="{{list.packingreqquantity}}" class="epackingreqquantity form-control" disabled />

                                    </td>
                                    <td>
                                        <input type="text" id="{{'eremainingqty'+$index}}" value="{{list.remainingqty}}" class="eremainingqty form-control" />
                                    </td> *@
                                 
                                    <td>
