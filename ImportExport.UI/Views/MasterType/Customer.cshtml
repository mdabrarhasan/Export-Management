<script src="~/customjs/mastertype/customer.js"></script>
<div ng-app="App" ng-controller="Ctl" ng-init="LoadData();GetCustomer()">
    <div ng-show="loading">
        <img style="width:50%;height:100%;position:absolute;z-index:1;" src="~/assets/images/Untitled.svg">
    </div>

    <div class="row">
        <div class="col-sm-12">
            <div class="card">

                <!-- HEADER -->
                <div class="card-header">
                    <h4>Customer Information</h4>
                </div>

                <!-- BODY -->
                <div class="card-body"
                     style="font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; font-size:14px;">

                    <!-- TOP BAR -->
                    <div class="row align-items-center mb-3">

                        <!-- ADD BUTTON -->
                        <div class="col-md-6 d-flex align-items-center">
                            <button type="button"
                                    class="btn btn-primary btn-sm d-inline-flex align-items-center gap-2 px-3 py-2 shadow-sm"
                                    ng-click="Clear()"
                                    data-bs-toggle="modal"
                                    data-bs-target="#customerModal">
                                <b>
                                    <i class="mdi mdi-plus"></i>
                                    <span>Add New</span>
                                </b>
                            </button>
                        </div>

                        <!-- SEARCH -->
                        <div class="col-md-6">
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="mdi mdi-magnify"></i>
                                </span>

                                <input type="text"
                                       ng-model="search"
                                       class="form-control"
                                       placeholder="Search Customer, TIN, BIN, IRC..."
                                       ng-change="onSearchChange()">

                                <button class="btn btn-outline-secondary"
                                        type="button"
                                        ng-click="search=''"
                                        ng-show="search">
                                    <i class="mdi mdi-close"></i>
                                </button>
                            </div>
                        </div>

                    </div>

                    <!-- TABLE -->
                    <div class="table-responsive">
                        <table id="tblinfo" class="table table-bordered table-hover">

                            <thead class="table-dark">
                                <tr>
                                    <th style="display:none;">ID</th>

                                    <th>Customer</th>
                                    <th>TIN</th>
                                    <th>BIN</th>
                                    <th>IRC</th>

                                    <th style="width:120px; text-align:center;">
                                        Action
                                    </th>
                                </tr>
                            </thead>

                            <tbody>
                                <tr dir-paginate="list in CustomerList | orderBy:'id':true | filter:search | itemsPerPage: pageSize"
                                    current-page="currentPage">

                                    <td style="display:none;">{{list.id}}</td>

                                    <td>{{list.cusname}}</td>
                                    <td>{{list.tin}}</td>
                                    <td>{{list.bin}}</td>
                                    <td>{{list.irc}}</td>

                                    <td class="text-center">

                                        <button type="button"
                                                class="btn btn-info btn-sm"
                                                ng-click="Edit(list)"
                                                data-bs-toggle="modal"
                                                data-bs-target="#customerModal">
                                            <i class="fa fa-edit"></i>
                                        </button>

                                        <button type="button"
                                                class="btn btn-danger btn-sm"
                                                ng-click="DeleteMaster(list.id)">
                                            <i class="fas fa-trash"></i>
                                        </button>

                                    </td>

                                </tr>
                            </tbody>

                        </table>
                    </div>

                    <div ng-init="currentPage=1; pageSize=10"></div>
                    <style>
                        /* Pagination container */
                        dir-pagination-controls ul {
                            display: flex;
                            justify-content: center;
                            align-items: center;
                            gap: 6px;
                            padding-left: 0;
                            margin-top: 20px;
                        }

                        /* Pagination items */
                        dir-pagination-controls li {
                            list-style: none;
                        }

                            /* Links */
                            dir-pagination-controls li a {
                                display: inline-block;
                                padding: 8px 14px;
                                border-radius: 8px;
                                background: #f8f9fa;
                                color: #0d6efd;
                                font-weight: 500;
                                border: 1px solid transparent;
                                transition: all 0.25s ease;
                            }

                                /* Hover effect */
                                dir-pagination-controls li a:hover {
                                    background: #e7f1ff;
                                    border-color: #0d6efd;
                                    text-decoration: none;
                                }

                            /* Active page */
                            dir-pagination-controls li.active a {
                                background: #0d6efd;
                                color: #fff;
                                border-color: #0d6efd;
                                box-shadow: 0 2px 6px rgba(13, 110, 253, 0.3);
                            }

                            /* Disabled state */
                            dir-pagination-controls li.disabled a {
                                background: #e9ecef;
                                color: #adb5bd;
                                cursor: not-allowed;
                            }

                            /* Optional: subtle click animation */
                            dir-pagination-controls li a:active {
                                transform: scale(0.95);
                            }
                    </style>
                    <div class="row mt-2 align-items-center">

                        <!-- LEFT: Total Records -->
                        <div class="col-md-4">
                            <span style="font-size:13px; font-weight:600; color:#444; letter-spacing:0.3px; opacity:0.75;">
                                Total Records:
                                <span style="color:#444; font-weight:700;">
                                    {{ (CustomerList | filter:search).length }}
                                </span>
                            </span>
                        </div>

                        <!-- CENTER: Pagination -->
                        <div class="col-md-4 text-center">

                            <dir-pagination-controls direction-links="true"
                                                     max-size="10"
                                                     boundary-links="true"
                                                     current-page="currentPage">
                            </dir-pagination-controls>

                        </div>

                        <!-- RIGHT: empty for balance -->
                        <div class="col-md-4"></div>

                    </div>

                </div>
            </div>
        </div>
    </div>

    <div id="customerModal" class="modal fade" tabindex="-1" aria-labelledby="customerModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-fullscreen">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="customerModalLabel">Customer Information</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    <form class="needs-validation" novalidate>
                        <input type="hidden" id="txtID" value="0" />

                        <div class="row">
                            <div class="col-sm-3">
                                <label>Customer Name :</label>
                                <input type="hidden" id="hcusid" />
                                <input type="text"
                                       class="form-control"
                                       ng-keyup="SearchCustomer()"
                                       ng-paste="SearchCustomer()"
                                       placeholder="Search Customer..."
                                       id="txtCustomerName"
                                       autocomplete="off" />
                                <span class="error">Select Customer</span>
                            </div>

                            <div class="col-sm-3">
                                <label>TIN :</label>
                                <input type="text" class="form-control" id="txtTIN" placeholder="Enter TIN..." />
                            </div>

                            <div class="col-sm-3">
                                <label>BIN :</label>
                                <input type="text" class="form-control" id="txtBIN" placeholder="Enter BIN..." />
                            </div>

                            <div class="col-sm-3">
                                <label>IRC :</label>
                                <input type="text" class="form-control" id="txtIRC" placeholder="Enter IRC..." />
                            </div>
                        </div>

                        <br />

                        <div class="modal-footer">
                            <button type="button" ng-click="Clear()" class="btn btn-warning" data-bs-dismiss="modal">
                                <i class="fas fa-times-circle"></i>
                            </button>
                            <button ng-click="Save()" id="savebutton" type="button" class="btn btn-success">
                                <i class="fas fa-check"></i>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>