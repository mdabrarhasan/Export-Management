                                    </select>
                                </div>

                                <div class="col-sm-7">
                                    <label>Value</label>
                                    <div class="d-flex gap-2">
                                        <input type="text"
                                               class="form-control"
                                               ng-model="inputValue"
                                               placeholder="Enter value..."
