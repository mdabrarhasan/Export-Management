<script src="~/customjs/mastertype/mastertype.js"></script>
<div ng-app="App" ng-controller="Ctl" ng-init="LoadData()">
    <div ng-show="loading">
        <img style="width:70%;height:100%;position:absolute;z-index:1;" src="~/assets/images/Untitled.svg">
    </div>

    <div class="row">
        <div class="col-sm-12">
            <div class="card">
                <div class="card-header">
                    <h4>Master Type Setup</h4>
                </div>

                <div class="card-body" style="font-family:'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; font-size:14px;">

                    <!-- Top Bar -->
                    <div class="row align-items-center mb-3">

                        <!-- Right: Search -->
                        <div class="col-md-6 ms-auto">
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="mdi mdi-magnify"></i>
                                </span>

                                <input type="text"
                                       ng-model="search"
                                       class="form-control"
                                       placeholder="Search value..."
                                       ng-change="onSearchChange()">

                                <button class="btn btn-outline-secondary"
                                        type="button"
                                        ng-click="search=''"
                                        ng-show="search">
                                    <i class="mdi mdi-close"></i>
                                </button>
                            </div>
                        </div>

                    </div>

                    
                    <!-- Insert Section -->
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <div class="row align-items-end">

                                <div class="col-sm-5">
                                    <label>Master Type</label>
                                    <select class="form-control"
                                            ng-model="SelectedType"
                                            ng-change="ChangeMasterType()"
                                            ng-options="m.Value as m.Text for m in MasterTypes">
                                    </select>
                                </div>

                                <div class="col-sm-7">
                                    <label>Value</label>
                                    <div class="d-flex gap-2">
                                        <input type="text"
                                               class="form-control"
                                               ng-model="inputValue"
                                               placeholder="Enter value..."
                                               ng-keyup="$event.keyCode === 13 && Save()" />

                                        <button ng-click="Save()"
                                                ng-disabled="!inputValue.trim() || saving"
                                                class="btn btn-success btn-sm">
                                            <i class="fas fa-check"></i>
                                        </button>
                                    </div>
                                    <small class="text-danger" ng-show="showValueError">Value Required</small>
                                </div>

                            </div>
                        </div>
                    </div>


                    @* <div class="row mb-4">
                        <div class="col-md-6">

                            <div class="row align-items-end">

                                <div class="col-sm-5">
                                    <label>Master Type</label>
                                    <select class="form-control"
                                            ng-model="SelectedType"
                                            ng-change="ChangeMasterType()"
