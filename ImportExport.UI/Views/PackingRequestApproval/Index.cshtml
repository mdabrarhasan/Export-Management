<script src="~/customjs/packingreq/packingrequestapproval.js"></script>
<script src="~/customjs/common.js"></script>

<div ng-app="App" ng-controller="Ctl">
    <div ng-show="loading">
        <img style="width:50%;height:100%;position:absolute;z-index:1;" src="~/assets/images/Untitled.svg">
    </div>

    <div class="row">
        <div class="col-sm-12">
            <div class="card">

                <!-- HEADER -->
                <div class="card-header">
                    <h4>Mill Declaration Approval</h4>
                </div>

                <div class="card-body" style="font-family:'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; font-size:14px;">

                    <!-- TOP CONTROLS -->
                    <div class="row align-items-center mb-3">

                        <!-- STATUS -->
                        <div class="col-md-3">
                            <select class="form-select"
                                    ng-model="statusid"
                                    ng-init="StatusList()"
                                    ng-change="PCList()">
                                <option value="">-- Status --</option>
                                <option ng-repeat="list in statuslist" value="{{list.code}}">
                                    {{list.name}}
                                </option>
                            </select>
                        </div>

                        <!-- MESSAGE -->
                        <div class="col-md-3">
                            <p id="Msg" class="text-muted mb-0"></p>
                        </div>

                        <!-- SEARCH -->
                        <div class="col-md-6">
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="mdi mdi-magnify"></i>
                                </span>

                                <input type="text"
                                       ng-model="search"
                                       class="form-control"
                                       placeholder="Search Packing Req, PI/SC, Customer...">

                                <button class="btn btn-outline-secondary"
                                        type="button"
                                        ng-click="search=''"
                                        ng-show="search">
                                    <i class="mdi mdi-close"></i>
                                </button>
                            </div>
                        </div>

                    </div>

                    <!-- TABLE -->
                    <div class="table-responsive">
                        <table class="table table-bordered table-hover" ng-init="GetAllData()">

                            <thead class="table-dark">
                                <tr>
                                    <th style="display:none;">ID</th>

                                    <th ng-click='sortBy("packreqnumber")'>Packing Req</th>
                                    <th ng-click='sortBy("piscnumber")'>PI / SC</th>
                                    <th ng-click='sortBy("customername")'>Customer</th>
                                    <th ng-click='sortBy("packreqdate")'>Req Date</th>
                                    <th ng-click='sortBy("currency")'>Currency</th>
                                    <th ng-click='sortBy("documentcreateddate")'>Created</th>

                                    <th>Status</th>
                                    <th style="width:180px;">Remarks</th>
                                    <th class="text-center" style="width:220px;">Action</th>
                                </tr>
                            </thead>

                            <tbody>
                                <tr dir-paginate="list in getalldata | orderBy:sortColumn:reverse | filter:search | itemsPerPage:pageSize"
                                    current-page="currentPage">

                                    <td style="display:none;">{{list.id}}</td>

                                    <td>{{list.packreqnumber}}</td>
                                    <td>{{list.piscnumber}}</td>
                                    <td>{{list.customername}}</td>
                                    <td>{{list.packreqdate}}</td>
                                    <td>{{list.currency}}</td>
                                    <td>{{list.documentcreateddate}}</td>

                                    <!-- STATUS -->
                                    <td>
                                        <span class="badge bg-info" ng-if='list.code=="PEND"'>{{list.docstatus}}</span>
                                        <span class="badge bg-success" ng-if='list.code=="APPR"'>{{list.docstatus}}</span>
                                        <span class="badge bg-danger" ng-if='list.code=="REJC"'>{{list.docstatus}}</span>
                                        <span class="badge bg-primary" ng-if='list.code=="COMP"'>{{list.docstatus}}</span>
                                    </td>

                                    <!-- REMARKS -->
                                    <td>
                                        <input type="text"
                                               class="form-control"
                                               ng-model="list.description"
                                               placeholder="Enter remarks">
                                    </td>

                                    <!-- ACTION -->
                                    <td class="text-center">

                                        <button type="button"
                                                class="btn btn-info btn-sm"
                                                data-bs-toggle="modal"
                                                data-bs-target="#ViewEditexampleModalFullscreen"
                                                ng-click="ViewData(list.id)">
                                            <i class="fas fa-search-plus"></i>
                                        </button>

                                        <button type="button"
                                                class="btn btn-danger btn-sm"
                                                ng-disabled='list.code!="PEND"'
                                                ng-click="Rejected(list.id,$index)">
                                            <i class="fas fa-times"></i>
                                        </button>

                                        <button type="button"
                                                class="btn btn-success btn-sm"
                                                ng-disabled='list.code!="PEND"'
                                                ng-click="Approved(list.id,$index)">
                                            <i class="fa fa-check"></i>
                                        </button>

                                        <button type="button"
                                                class="btn btn-secondary btn-sm"
                                                ng-show="list.code !== 'PEND'"
                                                ng-click="Cancled(3,list.piheaderid)">
                                            <i class="fa fa-ban"></i>
                                        </button>

                                    </td>

                                </tr>
                            </tbody>

                        </table>
                    </div>

                    <!-- PAGINATION INIT -->
                    <div ng-init="currentPage=1; pageSize=8"></div>

                    <!-- PAGINATION STYLE -->
                    <style>
                        dir-pagination-controls ul {
                            display: flex;
                            justify-content: center;
                            gap: 6px;
                            margin-top: 20px;
                            padding-left: 0;
                        }

                        dir-pagination-controls li {
                            list-style: none;
                        }

                            dir-pagination-controls li a {
                                padding: 8px 14px;
                                border-radius: 8px;
                                background: #f8f9fa;
                                color: #0d6efd;
                                transition: 0.25s;
                            }

                                dir-pagination-controls li a:hover {
                                    background: #e7f1ff;
                                }

                            dir-pagination-controls li.active a {
                                background: #0d6efd;
                                color: #fff;
                            }

                            dir-pagination-controls li.disabled a {
                                background: #e9ecef;
                                color: #adb5bd;
                            }
                    </style>

                    <!-- FOOTER -->
                    <div class="row mt-2 align-items-center">

                        <!-- TOTAL -->
                        <div class="col-md-4">
                            <span style="font-size:13px; font-weight:600; opacity:0.75;">
                                Total Records:
                                <b>{{ (getalldata | filter:search).length }}</b>
                            </span>
                        </div>

                        <!-- PAGINATION -->
                        <div class="col-md-4 text-center">
                            <dir-pagination-controls direction-links="true"
                                                     boundary-links="true"
                                                     current-page="currentPage">
                            </dir-pagination-controls>
                        </div>

                        <div class="col-md-4"></div>

                    </div>

                </div>
            </div>
        </div>
    </div>

    <div id="ViewEditexampleModalFullscreen" class="modal fade" tabindex="-1" aria-labelledby="EditexampleModalFullscreenLabel" aria-hidden="true">
        <div class="modal-dialog modal-fullscreen">
            <div class="modal-content">
                <div class="modal-header">
                    <h6 class="modal-title" id="myExtraLargeModalLabel">Mill Declaration (Approval Mode)</h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form class="needs-validation" novalidate>

                        <div class="row">
                            <div class="col-sm-3">
                            </div>
                            <div class="col-sm-6">
                                <input type="hidden" id="etxtPISCID" />
                                <table width="100%">
                                    <tr>
                                        <td style="width:120px;">Mill Declaration :</td>
                                        <td><input type="text" class="form-control" ng-keyup="SearchPI()" placeholder="Search PI/SC..." id="vtxtPISC" disabled /></td>
                                    </tr>
                                </table>
                            </div>
                            <div class="col-sm-3">
                            </div>
                        </div>
                        <br />

                        <div class="row">
                            <div class="col-sm-12">
                                <div class="card">

                                    <div class="card-header">
                                        <h6>Mill Declaration Information </h6>
                                    </div>

                                    <div class="card-body">
                                        <table id="tblview" ng-repeat="list in masterdata" class="table table-bordered" style="font-weight:bold">
                                            <tr>
                                                <td style="text-align:right">Invoice Number :</td>
                                                <td style="text-align:left">{{formatInvoiceNo(list.invoicenumber)}}</td>
                                                <td style="text-align:right">Invoice to :</td>
                                                <td style="text-align:left">{{list.invoiceto}}</td>
                                                <td style="text-align:right">Invoice Date :</td>
                                                <td style="text-align:left">
                                                    {{ list.invoicedate | date:'yyyy-MM-dd' }}
                                                </td>

                                            </tr>

                                            <tr>
                                                <td style="text-align:right">Mill dec. Number :</td>
                                                <td style="text-align:left">
                                                    {{list.packreqnumber}}
                                                </td>
                                                <td style="text-align:right">Packing Exp. date :</td>
                                                <td style="text-align:left">
                                                    {{ list.packreqdate | date:'yyyy-MM-dd' }}
                                                </td>
                                                <td style="text-align:right">Contract No :</td>
                                                <td style="text-align:left">
                                                    {{list.contractno}}
                                                </td>
                                            </tr>

                                            <tr>
                                                <td style="text-align:right">Shipped per :</td>
                                                <td style="text-align:left">{{list.shippedper}}</td>
                                                <td style="text-align:right">Shipped from :</td>
                                                <td style="text-align:left">{{list.shippedfrom}}</td>
                                                <td style="text-align:right">Shipped to :</td>
                                                <td style="text-align:left">{{list.shippedto}}</td>
                                            </tr>

                                            <tr>
                                                <td style="text-align:right">
                                                    Purchase Order No:
                                                </td>
                                                <td style="text-align:left">
                                                    {{list.purchaseorderno}}
                                                </td>
                                                <td style="text-align:right">
                                                    Purchase Order Date:
                                                </td>

                                                <td style="text-align:left">
                                                    {{ list.purchaseorderdated | date:'yyyy-MM-dd' }}
                                                </td>
                                                <td style="text-align:right"></td>
                                                <td style="text-align:left"></td>
                                            </tr>
                                            <tr>
                                                
                                            </tr>
                                        </table>
                                    </div>
                                </div>
                            </div>

                        </div>


                        <div class="row">
                          <div class="col-sm-12">
                            <div class="card">
                                <div class="card-header">
                                    <h4>List of Item :</h4>
                                </div>
                                <div class="card-body">
                                    
                                        <div style="max-height: 60vh; overflow: auto;">
                                            <table class="table table-bordered text-center" id="editmycontainer" style="table-layout: fixed; width: max-content;">
                                                <tr>
                                                    <th style="margin:30px;width: 50px;">Sl No.</th>
                                                    <th style="margin:30px;width: 90px;">Item Code</th>
                                                    <th style="margin:30px;width: 150px;">Item Name</th>
                                                    <th style="margin:30px;width: 120px;">UOM</th>
                                                    <th style="margin:30px;width: 120px;">Agg. wise Quantity</th>
                                                    <th style="margin:30px;width: 120px;">Rem. Quantity</th>
                                                    <th style="margin:30px;width: 120px;">Accepted Quantity</th>
                                                    <th style="margin:30px;width: 120px;">Exp Production Date</th>
                                                    <th style="margin:30px;width: 120px;">Total Truss</th>
                                                    <th style="margin:30px;width: 120px;">Total Bale</th>
                                                    <th style="margin:30px;width: 120px;">Total Tare</th>
                                                    <th style="margin:30px;width: 120px;">Total Bundle</th>
                                                    <th style="margin:30px;width: 120px;">Total Pallet</th>
                                                    <th style="margin:30px;width: 120px;">Total Cartoon</th>
                                                    <th style="margin:30px;width: 120px;">Additional Weight</th>
                                                    <th style="margin:30px;width: 120px;">Gross weight</th>
                                                    <th style="margin:30px;width: 150px;">Truss/Carton Measurement</th>
                                                    <th style="margin:30px;width: 100px;">SI No</th>
                                                    <th style="margin:30px;width: 100px;">Total Spool</th>
                                                    <th style="margin:30px;width: 100px;">Mill ID</th>
                                                    <th style="margin:30px;width: 100px;">Mark Ink</th>
                                                    <th style="margin:30px;width: 100px;">Spool/Palat</th>
                                                    <th style="margin:30px;width: 100px;">Remarks</th>
                                                    <th style="margin:30px;width: 100px;">Short Description</th>
                                                </tr>

                                                <tr ng-repeat="list in listdetails">
                                                    <td style="width: 50px;">{{$index+1}}</td>
                                                    <td style="width: 90px;"><input type="text" class="form-control" value="{{list.itemid}}" disabled /></td>
                                                    <td style="width: 150px;"><input class="form-control" type="text" value="{{list.itemname}}" disabled></td>
                                                    <td style="width: 50px;"><input type="text" class="form-control" value="{{list.uom}}" disabled /></td>
                                                    <td style="width: 50px;"><input type="text" class="form-control" value="{{list.quantity}}" disabled /></td>
                                                    <td style="width: 50px;"><input type="text" value="{{list.remainingqty}}" class="form-control" disabled /></td>
                                                    <td style="width: 50px;"><input type="text" value="{{list.packingreqquantity}}" class="form-control" disabled /></td>
                                                    <td style="width: 50px;"><input type="date" value="{{list.expproductionorderdate | date:'yyyy-MM-dd'}}" class="form-control" disabled /></td>
                                                    <td style="width: 50px;"><input class="form-control" type="text" value="{{list.trussNo}}" disabled /></td>
                                                    <td style="width: 50px;"><input class="form-control" type="text" value="{{list.totalBale}}" disabled /></td>
                                                    <td style="width: 50px;"><input class="form-control" type="text" value="{{list.totalTare}}" disabled /></td>
                                                    <td style="width: 50px;"><input class="form-control" type="text" value="{{list.countNo}}" disabled /></td>
                                                    <td style="width: 50px;"><input class="form-control" type="text" value="{{list.totalPallet}}" disabled /></td>
                                                    <td style="width: 50px;"><input class="form-control" type="text" value="{{list.totalCartoon}}" disabled /></td>
                                                    <td style="width: 50px;"><input class="form-control" type="text" value="{{list.addWeight}}" disabled /></td>
                                                    <td style="width: 100px;"><input class="form-control" type="text" value="{{list.grossWeight}}" disabled /></td>
                                                    <td style="width: 150px;"><input class="form-control" type="text" value="{{list.measurement}}" disabled /></td>
                                                    <td style="width: 100px;"><input class="form-control" type="text" value="{{list.siNo}}" disabled /></td>
                                                    <td style="width: 100px;"><input class="form-control" type="text" value="{{list.totalSpool}}" disabled /></td>
                                                    <td style="width: 100px;"><input class="form-control" type="text" value="{{list.millname || list.millid}}" disabled /></td>
                                                    <td style="width: 100px;"><input class="form-control" type="text" value="{{list.markInk}}" disabled /></td>
                                                    <td style="width: 100px;"><input class="form-control" type="text" value="{{list.spoolOrPalat}}" disabled /></td>
                                                    <td style="width: 100px;"><input type="text" value="{{list.remarks}}" class="form-control" disabled /></td>
                                                    <td style="width: 100px;"><input type="text" value="{{list.descriptions}}" class="form-control" disabled /></td>
                                                </tr>
                                            </table>
                                        </div>
                                    
                                </div>
                            </div>
                          </div>
                        </div>
                        
                        
                        <div class="modal-footer">
                            <button type="button" class="btn btn-warning sm" data-bs-dismiss="modal"><i class="fas fa-times-circle"></i></button>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
