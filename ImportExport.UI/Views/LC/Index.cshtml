<script src="~/customjs/lc/lc.js"></script>
<script src="~/customjs/Common.js"></script>
<style>
    #printid option {
        text-align: left;
    }
</style>

<div ng-app="App" ng-controller="Ctl">
    <div ng-show="loading">
        <img style="width:70%;height:100%;position:absolute;z-index:1;" src="~/assets/images/Untitled.svg">
    </div>

    <div class="row">
        <div class="col-sm-12">
            <div class="card">

                <!-- HEADER -->
                <div class="card-header">
                    <h4>LC Management</h4>
                </div>

                <div class="card-body" style="font-family:'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; font-size:14px;">

                    <!-- TOP CONTROLS -->
                    <div class="row align-items-center mb-3">

                        <div class="row align-items-center g-2">

                            <!-- CREATE BUTTON-->
                            <div class="col-md-auto d-flex align-items-center">
                                <button type="button"
                                        class="btn btn-primary btn-sm d-inline-flex align-items-center gap-2 px-3 py-2 shadow-sm"
                                        ng-click="Clear()"
                                        data-bs-toggle="modal"
                                        data-bs-target="#exampleModalFullscreen">
                                    <b>
                                        <i class="mdi mdi-plus"></i>
                                        <span>Add New</span>
                                    </b>
                                </button>
                            </div>

                            <!-- BUSINESS UNIT -->
                            <div class="col-md-3">
                                <select id="unitidforload"
                                        class="form-select"
                                        ng-model="unitidforload"
                                        ng-init="GetUnit()"
                                        ng-change="LoadData()">
                                    <option value="">-- Business Unit --</option>
                                    <option ng-repeat="list in unitlist" value="{{list.id}}">
                                        {{list.name}}
                                    </option>
                                </select>
                            </div>

                            <!-- TYPE -->
                            <div class="col-md-3">
                                <select id="typeidforload"
                                        class="form-select"
                                        ng-model="typeidforload"
                                        ng-init="GetDocument()"
                                        ng-change="LoadDatabytype()">
                                    <option value="">-- Type --</option>
                                    <option ng-repeat="list in documentstypelist" value="{{list.id}}">
                                        {{list.name}}
                                    </option>
                                </select>
                            </div>

                            <!-- SEARCH-->
                            <div class="col">
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="mdi mdi-magnify"></i>
                                    </span>

                                    <input type="text"
                                           ng-model="search"
                                           class="form-control"
                                           placeholder="Search LC No, Customer...">

                                    <button class="btn btn-outline-secondary"
                                            type="button"
                                            ng-click="search=''"
                                            ng-show="search">
                                        <i class="mdi mdi-close"></i>
                                    </button>
                                </div>
                            </div>

                        </div>

                    </div>

                    <!-- TABLE -->
                    <div class="table-responsive">
                        <table class="table table-bordered table-hover">

                            <thead class="table-dark">
                                <tr>
                                    <th style="display:none;">ID</th>

                                    <th ng-click='sortBy("lcnumber")'>LC No</th>
                                    <th ng-click='sortBy("lcissuedate")'>Issue Date</th>
                                    <th ng-click='sortBy("lcexpiredate")'>Expire Date</th>
                                    <th ng-click='sortBy("lcexpiredplace")'>Created Place</th>
                                    <th ng-click='sortBy("toelrancecramtpercentage")'>Tolerance (%)</th>
                                    <th ng-click='sortBy("cusname")'>Customer</th>
                                    <th ng-click='sortBy("currency")'>Currency</th>

                                    <th>Status</th>
                                    <th style="width:160px;">Action</th>
                                </tr>
                            </thead>

                            <tbody>
                                <tr dir-paginate="list in LClist | orderBy:sortColumn:reverse | filter:search | itemsPerPage:pageSize"
                                    current-page="currentPage">

                                    <td style="display:none;">{{list.id}}</td>

                                    <td>{{list.lcnumber}}</td>
                                    <td>{{list.lcissuedate}}</td>
                                    <td>{{list.lcexpiredate}}</td>
                                    <td>{{list.lcexpiredplace}}</td>
                                    <td>{{list.toelrancecramtpercentage}}</td>
                                    <td>{{list.cusname}}</td>
                                    <td>{{list.currency}}</td>

                                    <!-- STATUS -->
                                    <td>
                                        <span class="badge rounded-pill badge-soft-info" ng-if='list.code=="PEND"'>{{list.docstatus}}</span>
                                        <span class="badge rounded-pill badge-soft-success" ng-if='list.code=="APPR"'>{{list.docstatus}}</span>
                                        <span class="badge rounded-pill badge-soft-danger" ng-if='list.code=="REJC"'>{{list.docstatus}}</span>
                                        <span class="badge rounded-pill badge-soft-primary" ng-if='list.code=="COMP"'>{{list.docstatus}}</span>
                                    </td>

                                    <!-- ACTION -->
                                    <td class="text-center">

                                        <button type="button"
                                                class="btn btn-info btn-sm"
                                                data-bs-toggle="modal"
                                                data-bs-target="#ViewEditexampleModalFullscreen"
                                                ng-click="ViewCData(list.id,list.pischeaderid)">
                                            <i class="fas fa-search-plus"></i>
                                        </button>

                                        <button type="button"
                                                class="btn btn-info btn-sm"
                                                data-bs-toggle="modal"
                                                data-bs-target="#EditexampleModalFullscreen"
                                                ng-click="EditbyMasterID(list.id,list.pischeaderid)">
                                            <i class="fa fa-edit"></i>
                                        </button>

                                        <button type="button"
                                                class="btn btn-danger btn-sm"
                                                ng-click="DeleteMaster(list.id)">
                                            <i class="fa fa-trash"></i>
                                        </button>

                                    </td>

                                </tr>
                            </tbody>

                        </table>
                    </div>

                    <!-- PAGINATION INIT -->
                    <div ng-init="currentPage=1; pageSize=8"></div>

                    <!-- PAGINATION STYLE -->
                    <style>
                        dir-pagination-controls ul {
                            display: flex;
                            justify-content: center;
                            gap: 6px;
                            margin-top: 20px;
                            padding-left: 0;
                        }

                        dir-pagination-controls li {
                            list-style: none;
                        }

                            dir-pagination-controls li a {
                                padding: 8px 14px;
                                border-radius: 8px;
                                background: #f8f9fa;
                                color: #0d6efd;
                                transition: 0.25s;
                            }

                                dir-pagination-controls li a:hover {
                                    background: #e7f1ff;
                                }

                            dir-pagination-controls li.active a {
                                background: #0d6efd;
                                color: #fff;
                            }

                            dir-pagination-controls li.disabled a {
                                background: #e9ecef;
                                color: #adb5bd;
                            }
                    </style>

                    <!-- FOOTER -->
                    <div class="row mt-2 align-items-center">

                        <!-- TOTAL -->
                        <div class="col-md-4">
                            <span style="font-size:13px; font-weight:600; opacity:0.75;">
                                Total Records:
                                <b>{{ (LClist | filter:search).length }}</b>
                            </span>
                        </div>

                        <!-- PAGINATION -->
                        <div class="col-md-4 text-center">
                            <dir-pagination-controls direction-links="true"
                                                     boundary-links="true"
                                                     current-page="currentPage">
                            </dir-pagination-controls>
                        </div>

                        <div class="col-md-4"></div>

                    </div>

                </div>
            </div>
        </div>
    </div>

