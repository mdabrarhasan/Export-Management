<script src="~/customjs/PriceConfirm/PriceConfirmApproval.js"></script>

<script src="~/customjs/common.js"></script>

<div ng-app="App" ng-controller="Ctl">
    <div ng-show="loading">
        <img style="width:50%;height:100%;position:absolute;z-index:1;" src="~/assets/images/Untitled.svg">
    </div>

    <div class="row">
        <div class="col-sm-12">
            <div class="card">

                <!-- HEADER -->
                <div class="card-header">
                    <h4>Price Confirmation Approval</h4>
                </div>

                <div class="card-body" style="font-family:'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; font-size:14px;">

                    <!-- TOP CONTROLS -->
                    <div class="row align-items-center mb-3">

                        <!-- BUSINESS UNIT -->
                        <div class="col-md-3">
                            <select class="form-select"
                                    ng-model="unitid"
                                    ng-init="GetUnit()">
                                <option value="">-- Business Unit --</option>
                                <option ng-repeat="list in unitlist" value="{{list.id}}">
                                    {{list.name}}
                                </option>
                            </select>
                        </div>

                        <!-- STATUS -->
                        <div class="col-md-3">
                            <select class="form-select"
                                    ng-model="statusid"
                                    ng-init="StatusList()"
                                    ng-change="PCList()">
                                <option value="">-- Status --</option>
                                <option ng-repeat="list in statuslist" value="{{list.code}}">
                                    {{list.name}}
                                </option>
                            </select>
                        </div>

                        <!-- SEARCH -->
                        <div class="col-md-6">
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="mdi mdi-magnify"></i>
                                </span>

                                <input type="text"
                                       ng-model="search"
                                       class="form-control"
                                       placeholder="Search PC No, Customer, Seller...">

                                <button class="btn btn-outline-secondary"
                                        type="button"
                                        ng-click="search=''"
                                        ng-show="search">
                                    <i class="mdi mdi-close"></i>
                                </button>
                            </div>
                        </div>

                    </div>

                    <!-- TABLE -->
                    <div class="table-responsive">
                        <table class="table table-bordered table-hover">

                            <thead class="table-dark">
                                <tr>
                                    <th style="display:none;">ID</th>

                                    <th ng-click='sortBy("lcnumber")'>PC No</th>
                                    <th ng-click='sortBy("lcexpiredate")'>SQ No</th>
                                    <th ng-click='sortBy("lccreatedplace")'>Type</th>
                                    <th ng-click='sortBy("lccreatedplace")'>Date</th>
                                    <th ng-click='sortBy("toelrancecramtpercentage")'>Customer</th>
                                    <th ng-click='sortBy("cusname")'>Seller</th>
                                    <th ng-click='sortBy("paymentterm")'>Currency</th>

                                    <th>Status</th>
                                    <th style="width:180px;">Remarks</th>
                                    <th class="text-center" style="width:200px;">Action</th>
                                </tr>
                            </thead>

                            <tbody>
                                <tr dir-paginate="list in PClist | orderBy:sortColumn:reverse | filter:search | itemsPerPage:pageSize"
                                    current-page="currentPage">

                                    <td style="display:none;">{{list.id}}</td>

                                    <td>{{list.pcnumber}}</td>
                                    <td>{{list.sqnumber}}</td>
                                    <td>{{list.agreementtype}}</td>
                                    <td>{{list.documentcreateddate}}</td>
                                    <td>{{list.cusname}}</td>
                                    <td>{{list.sellername}}</td>
                                    <td>{{list.currency}}</td>

                                    <!-- STATUS -->
                                    <td>
                                        <span class="badge bg-info" ng-if='list.code=="PEND"'>{{list.docstatus}}</span>
                                        <span class="badge bg-success" ng-if='list.code=="APPR"'>{{list.docstatus}}</span>
                                        <span class="badge bg-danger" ng-if='list.code=="REJC"'>{{list.docstatus}}</span>
                                        <span class="badge bg-primary" ng-if='list.code=="COMP"'>{{list.docstatus}}</span>
                                    </td>

                                    <!-- REMARKS -->
                                    <td>
                                        <input type="text"
                                               class="form-control"
                                               ng-model="list.descriptions"
                                               placeholder="Remarks">
                                    </td>

                                    <!-- ACTION -->
                                    <td class="text-center">

                                        <button type="button"
                                                class="btn btn-info btn-sm"
                                                data-bs-toggle="modal"
                                                data-bs-target="#ViewexampleModalFullscreen"
                                                ng-click="ViewCData(list.id,list.proformainvoiceheaderid,list.unitid)">
                                            <i class="fas fa-search-plus"></i>
                                        </button>

                                        <button type="button"
                                                class="btn btn-info btn-sm"
                                                ng-disabled='list.code=="APPR"'
                                                data-bs-toggle="modal"
                                                data-bs-target="#EditexampleModalFullscreen"
                                                ng-click="EditbyMasterID(list.id,list.customerid,list.unitid,list.number,list.descriptions,list.termscondition,list.histryid,list.businessunitid)">
                                            <i class="fa fa-edit"></i>
                                        </button>

                                        <button type="button"
                                                class="btn btn-danger btn-sm"
                                                ng-disabled='list.code=="APPR"'
                                                ng-click="DeleteMaster(list.id)">
                                            <i class="fa fa-trash"></i>
                                        </button>

                                    </td>

                                </tr>
                            </tbody>

                        </table>
                    </div>

                    <!-- PAGINATION INIT -->
                    <div ng-init="currentPage=1; pageSize=8"></div>

                    <!-- PAGINATION STYLE -->
                    <style>
                        dir-pagination-controls ul {
                            display: flex;
                            justify-content: center;
                            gap: 6px;
                            margin-top: 20px;
                            padding-left: 0;
                        }

                        dir-pagination-controls li {
                            list-style: none;
                        }

                            dir-pagination-controls li a {
                                padding: 8px 14px;
                                border-radius: 8px;
                                background: #f8f9fa;
                                color: #0d6efd;
                                transition: 0.25s;
                            }

                                dir-pagination-controls li a:hover {
                                    background: #e7f1ff;
                                }

                            dir-pagination-controls li.active a {
                                background: #0d6efd;
                                color: #fff;
                            }

                            dir-pagination-controls li.disabled a {
                                background: #e9ecef;
                                color: #adb5bd;
                            }
                    </style>

                    <!-- FOOTER -->
                    <div class="row mt-2 align-items-center">

                        <!-- TOTAL -->
                        <div class="col-md-4">
                            <span style="font-size:13px; font-weight:600; opacity:0.75;">
                                Total Records:
                                <b>{{ (PClist | filter:search).length }}</b>
                            </span>
                        </div>

                        <!-- PAGINATION -->
                        <div class="col-md-4 text-center">
                            <dir-pagination-controls direction-links="true"
                                                     boundary-links="true"
                                                     current-page="currentPage">
                            </dir-pagination-controls>
                        </div>

                        <div class="col-md-4"></div>

                    </div>

                </div>
            </div>
        </div>
    </div>

    <div id="ViewexampleModalFullscreen" class="modal fade" tabindex="-1" aria-labelledby="EditexampleModalFullscreenLabel" aria-hidden="true">
        <div class="modal-dialog modal-fullscreen">
