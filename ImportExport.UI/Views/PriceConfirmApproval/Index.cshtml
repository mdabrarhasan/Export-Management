                                                <span ng-show="sortColumn=='confirmprice'" ng-class="{'fa fa-angle-double-down' : !reverse, 'fa fa-angle-double-up' : reverse}"></span>
                                            </th>
                                        </tr>

                                        <tr ng-repeat="list in pclistdetails">
                                            <td style="display:none;">{{list.id}}</td>
                                            <td>{{$index+1}}</td>
                                            <td>{{list.itemid}}</td>
                                            <td>{{list.itemname}}</td>
                                            <td>{{list.quantity}}</td>
                                            <td>{{list.price}}</td>
                                            <td>{{list.totalamount}}</td>
                                            <td>{{list.currencycode}}</td>
                                            <td style="display:none">{{list.offerprice}}</td>
                                            <td style="display:none">{{list.confirmprice}}</td>
                                    </table>
                                </div>
                            </div>
                        </div>
