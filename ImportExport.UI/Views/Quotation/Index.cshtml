    <div id="exampleModalFullscreen" class="modal fade" tabindex="-1" aria-labelledby="exampleModalFullscreenLabel" aria-hidden="true" data-backdrop="static">
        <div class="modal-dialog modal-fullscreen">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="myExtraLargeModalLabel">Quotation (Insertion Mode)</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form class="needs-validation" novalidate>
                        <div class="row">
                            <div class="col-sm-12">
                                <div class="card">
                                    <div class="card-header">
                                        <h6>Quote To </h6>
                                    </div>
                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-sm-3">
                                                <label>Quotation Type :</label>
                                                <select class="quotationtypeid form-select" ng-model="selectedItemValue" ng-init="GetQuotationList()" ng-change="EnabledDisabled()"
                                                        id="quotationtypeid">
                                                    <option value="">--Select--</option>
                                                    <option ng-repeat="list in quotationlist" value="{{list.id}}">
                                                        {{list.name}}
                                                    </option>
                                                </select>
                                                <span class="error">Select Quotation Type</span>
                                            </div>

                                          

                                            <div class="col-sm-3">
                                                <label>Buyer Name :</label>
                                                <input type="hidden" id="hcusid" />
                                                <input type="text" class="form-control" ng-keyup="SearchHeaderBuyer()" placeholder="Search Buyer..." id="txtBuyerName" autocomplete="off" />
                                                <span class="error">Select Buyer</span>
                                            </div>

                                            <div class="col-sm-3">
                                                <label>Uploaded By</label>
                                            <select class="excel form-select" ng-change="EnabledDisabledExcel()" ng-model="excel"
                                                    id="excel">
                                                <option value="">--Select--</option>
                                                <option value="1">Upload Via Excel</option>
                                                <option value="2">Uploaded Manually</option>
                                                <option value="3">Ocf Create</option>
                                            </select>
