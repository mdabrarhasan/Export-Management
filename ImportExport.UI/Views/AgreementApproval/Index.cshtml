<script src="~/customjs/agreement/agreementapproval.js"></script>
<script src="~/customjs/common.js"></script>

<div ng-app="App" ng-controller="Ctl">
    <div ng-show="loading">
        <img style="width:70%;height:100%;position:absolute;z-index:1;" src="~/assets/images/Untitled.svg">
    </div>

    <div class="row">
        <div class="col-sm-12">
            <div class="card">

                <!-- HEADER -->
                <div class="card-header">
                    <h4>Agreement Approval</h4>
                </div>

                <div class="card-body" style="font-family:'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; font-size:14px;">

                    <!-- TOP CONTROLS -->
                    <div class="row align-items-center mb-3">

                        <!-- AGREEMENT TYPE -->
                        <div class="col-md-3">
                            <select class="form-select"
                                    ng-model="agreementtypeid"
                                    ng-init="AgreementType()"
                                    ng-change="PIList()">
                                <option value="">-- Agreement Type --</option>
                                <option ng-repeat="list in Agreementtype" value="{{list.code}}">
                                    {{list.name}}
                                </option>
                            </select>
                        </div>

                        <!-- STATUS -->
                        <div class="col-md-3">
                            <select class="form-select"
                                    ng-model="statusid"
                                    ng-init="StatusList()"
                                    ng-change="PIList()">
                                <option value="">-- Status --</option>
                                <option ng-repeat="list in statuslist" value="{{list.code}}">
                                    {{list.name}}
                                </option>
                            </select>
                        </div>

                        <!-- SEARCH -->
                        <div class="col-md-6">
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="mdi mdi-magnify"></i>
                                </span>

                                <input type="text"
                                       ng-model="search"
                                       class="form-control"
                                       placeholder="Search PI, Customer, SQ...">

                                <button class="btn btn-outline-secondary"
                                        type="button"
                                        ng-click="search=''"
                                        ng-show="search">
                                    <i class="mdi mdi-close"></i>
                                </button>
                            </div>
                        </div>

                    </div>

                    <!-- TABLE -->
                    <div class="table-responsive">
                        <table class="table table-bordered table-hover">

                            <thead class="table-dark">
                                <tr>
                                    <th style="display:none;">ID</th>

                                    <th ng-click='sortBy("PINUMBER")'>PI No</th>
                                    <th ng-click='sortBy("PIDATE")'>Date</th>
                                    <th ng-click='sortBy("CUSTOMERNAME")'>Customer</th>
                                    <th ng-click='sortBy("SQNUMBER")'>SQ No</th>
                                    <th ng-click='sortBy("PAYMENTTERM")'>Payment</th>
                                    <th ng-click='sortBy("SHIPMENT")'>Shipment</th>
                                    <th ng-click='sortBy("FROMSHIPMENTCOUNTRY")'>From</th>
                                    <th ng-click='sortBy("TOSHIPMENTCOUNTRY")'>To</th>
                                    <th ng-click='sortBy("INTOTERM")'>Inco</th>
                                    <th ng-click='sortBy("documentcreateddate")'>Created</th>

                                    <th>Status</th>
                                    <th style="width:180px;">Remarks</th>
                                    <th style="width:220px;" class="text-center">Action</th>
                                </tr>
                            </thead>

                            <tbody>
                                <tr dir-paginate="list in PIlist | orderBy:sortColumn:reverse | filter:search | itemsPerPage:pageSize"
                                    current-page="currentPage">

                                    <td style="display:none;">{{list.agreementid}}</td>

                                    <td>{{list.pinumber}}</td>
                                    <td>{{list.pidate}}</td>
                                    <td>{{list.customername}}</td>
                                    <td>{{list.sqnumber}}</td>
                                    <td>{{list.paymentterm}}</td>
                                    <td>{{list.shipment}}</td>
                                    <td>{{list.fromshipmentcountry}}</td>
                                    <td>{{list.toshipmentcountry}}</td>
                                    <td>{{list.intoterm}}</td>
                                    <td>{{list.documentcreateddate}}</td>

                                    <!-- STATUS -->
                                    <td>
                                        <span class="badge bg-info" ng-if='list.code=="PEND"'>{{list.dosstatus}}</span>
                                        <span class="badge bg-success" ng-if='list.code=="APPR"'>{{list.dosstatus}}</span>
                                        <span class="badge bg-danger" ng-if='list.code=="REJC"'>{{list.dosstatus}}</span>
                                        <span class="badge bg-primary" ng-if='list.code=="COMP"'>{{list.dosstatus}}</span>
                                    </td>

                                    <!-- REMARKS -->
                                    <td>
                                        <input type="text"
                                               class="form-control"
                                               ng-model="list.descriptions"
                                               placeholder="Enter remarks">
                                    </td>

                                    <!-- ACTIONS -->
                                    <td class="text-center">

                                        <button type="button"
                                               class="btn btn-info btn-sm"
                                                data-bs-toggle="modal"
                                                data-bs-target="#EditexampleModalFullscreen"
                                                ng-click="ViewByMasterID(list.agreementid)">
                                            <i class="fas fa-search-plus"></i>
                                        </button>

                                        <button type="button"
                                                class="btn btn-danger btn-sm"
                                                ng-disabled='list.code!="PEND"'
                                                ng-click="Rejected(list.histryid,$index)">
                                            <i class="fas fa-times"></i>
                                        </button>

                                        <button type="button"
                                                class="btn btn-success btn-sm"
                                                ng-disabled='list.code!="PEND"'
                                                ng-click="Approved(list.agreementid,list.histryid,$index)">
                                            <i class="fa fa-check"></i>
                                        </button>

                                        <button type="button"
                                                class="btn btn-secondary btn-sm"
                                                ng-show="list.code !== 'PEND'"
                                                ng-click="Cancled(2,list.agreementid)">
                                            <i class="fa fa-ban"></i>
                                        </button>

                                        <button type="button"
                                                class="btn btn-warning btn-sm"
                                                ng-show="list.code !== 'PEND'"
                                                ng-click="Ropen(2,list.agreementid)">
                                            <i class="fa fa-undo"></i>
                                        </button>

                                    </td>

                                </tr>
                            </tbody>

                        </table>
                    </div>

                    <!-- PAGINATION INIT -->
                    <div ng-init="currentPage=1; pageSize=8"></div>

                    <!-- PAGINATION STYLE -->
                    <style>
                        dir-pagination-controls ul {
                            display: flex;
                            justify-content: center;
                            gap: 6px;
                            margin-top: 20px;
                            padding-left: 0;
                        }

                        dir-pagination-controls li {
                            list-style: none;
                        }

                            dir-pagination-controls li a {
                                padding: 8px 14px;
                                border-radius: 8px;
                                background: #f8f9fa;
                                color: #0d6efd;
                                transition: 0.25s;
                            }

                                dir-pagination-controls li a:hover {
                                    background: #e7f1ff;
                                }

                            dir-pagination-controls li.active a {
                                background: #0d6efd;
                                color: #fff;
                            }

                            dir-pagination-controls li.disabled a {
                                background: #e9ecef;
                                color: #adb5bd;
                            }
                    </style>

                    <!-- FOOTER -->
                    <div class="row mt-2 align-items-center">

                        <!-- TOTAL -->
                        <div class="col-md-4">
                            <span style="font-size:13px; font-weight:600; opacity:0.75;">
                                Total Records:
                                <b>{{ (PIlist | filter:search).length }}</b>
                            </span>
                        </div>

                        <!-- PAGINATION -->
                        <div class="col-md-4 text-center">
                            <dir-pagination-controls direction-links="true"
                                                     boundary-links="true"
                                                     current-page="currentPage">
                            </dir-pagination-controls>
                        </div>

                        <div class="col-md-4"></div>

                    </div>

                </div>
            </div>
        </div>
    </div>

    <div id="EditexampleModalFullscreen" class="modal fade" tabindex="-1" aria-labelledby="EditexampleModalFullscreenLabel" aria-hidden="true">
        <div class="modal-dialog modal-fullscreen">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="myExtraLargeModalLabel">Agreement (View Mode)</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form class="needs-validation" novalidate>
                        <div class="row">
                            <div class="col-sm-12">
                                <div class="card">

                                    <div class="card-header">
                                        <h6>Header Information</h6>
                                    </div>

                                    <div class="card-body">
                                        <div row table-responsive>
                                            <table id="tblview" ng-repeat="list in masterdata" class="table table-bordered" style="font-weight:bold">
                                                <tr>
                                                    <td style="text-align:right">Customer Name :</td>
                                                    <td style="text-align:left">{{list.customername}}</td>
                                                    <td style="text-align:right">From Shipment :</td>
                                                    <td style="text-align:left">{{list.fromshipmentcountry}}</td>
                                                    <td style="text-align:right">To Shipment :</td>
                                                    <td style="text-align:left">{{list.toshipmentcountry}}</td>
                                                </tr>
                                                <tr>
                                                    <td style="text-align:right">Buyer Contract No :</td>
                                                    <td style="text-align:left">{{list.buyerregno}}</td>
                                                    <td style="text-align:right">Loading Port :</td>
                                                    <td style="text-align:left">{{list.fromshipmentport}}</td>
                                                    <td style="text-align:right">Destination Port :</td>
                                                    <td style="text-align:left">{{list.toshipmentport}}</td>
                                                </tr>
                                                <tr>
                                                    <td style="text-align:right">Currency :</td>
                                                    <td style="text-align:left">{{list.currency}}</td>
                                                    <td style="text-align:right">Inco Term :</td>
                                                    <td style="text-align:left">{{list.intoterm}}</td>
                                                    <td style="text-align:right">Expire Date :</td>
                                                    <td style="text-align:left">{{list.piexpiredate}}</td>
                                                </tr>
                                                <tr>
                                                    <td style="text-align:right">PI/SC Number :</td>
                                                    <td style="text-align:left">{{list.pinumber}}</td>
                                                    <td style="text-align:right">Shipment Mode :</td>
                                                    <td style="text-align:left">{{list.shipment}}</td>
                                                    <td style="text-align:right">Payment Term</td>
                                                    <td style="text-align:left">{{list.paymentterm}}</td>
                                                </tr>
                                                <tr>
                                                    <td style="text-align:right">Date :</td>
                                                    <td style="text-align:left">{{list.pidate}}</td>
                                                </tr>
                                            </table>
                                        </div>
                                        
                                    </div>
                                </div>
                            </div>
                           
                        </div>
                        <div class="row table-responsive">
                            <div class="col-sm-12">
                                <h4>List of Item's</h4>
                                <table class="table table-bordered" id="editmycontainer">
                                    <tr>
                                        <th>Sl No.</th>
                                        <th>Item Code</th>
                                        <th>Item Name</th>
                                        <th>UOM</th>
                                        <th>Quantity</th>
                                        <th>Unit Price</th>
                                       @* <th>Vat%</th>
                                        <th>Vat Amount</th>*@
                                        <th>Discount%</th>
                                        <th>Dis. Amount</th>
                                        <th>Total Amount</th>
                                        <th>Short Details</th>
                                        @* <th>Short Details</th> *@

                                    </tr>

                                    <tr ng-repeat="list in detailsbyid">
                                        <td>
                                            {{$index+1}}
                                        </td>
                                        <td>
                                            {{list.itemid}}
                                        </td>
                                        <td style="width:350px">
                                            {{list.itemname}}
                                        </td>

                                        <td>
                                            {{list.uom}}
                                        </td>

                                        <td>
                                            {{list.quantity}}
                                        </td>
                                        <td>
                                            {{list.price}}
                                        </td>
                                        
                                       @* <td>
                                            {{list.vatname}}
                                        </td>
                                        <td>
                                            {{list.vatamount}}
                                        </td>*@
                                        <td>
                                        {{list.disname}}
                                        </td>
                                        <td>
                                            {{list.discount}}
                                        </td>

                                        <td>
                                            {{list.totalamount}}

                                        </td>
                                        <td>
                                            {{list.remarks}}
                                        </td>
                                        @* <td>
                                            {{list.descriptions}}
                                        </td> *@
                                    </tr>
                                </table>
                            </div>
                        </div>
                        <br />


                        <div class="row">
                            <div class="col-sm-12">
                                <h5>Attachment</h5>
                                <table class="table table-bordered">
                                    <tr>
                                        <th>Sl No</th>
                                        <th>File Name</th>
                                        @*  <th>File Type</th> *@
                                        <th>Action</th>
                                    </tr>
                                    <tr>
                                        <td><label id="vSINO"></label></td>
                                        <td><label id="vFileName"></label></td>
                                        @*   <td><label id="vFileType"></label></td> *@
                                        <td>  <button type="button" class="btn btn-primary btn-sm insert" id="downloadButton">Download File</button>  </td>
                                    </tr>
                                </table>
                            </div>
                        </div>



                    @*     <div class="row table-responsive">
                            <div class="col-sm-12">
                                <h5>Attachment</h5>
                                <table class="table table-bordered">
                                    <tr>
                                        <th>Sl No</th>
                                        <th>File Name</th>
                                        <th>File Type</th>
                                        <th>Action</th>
                                    </tr>
                                    <tr ng-repeat="list in imageitem">
                                        <td>{{$index+1}}</td>
                                        <td>{{list.fileName}}</td>
                                        <td>{{list.extension}}</td>
                                        <td><button class="btn btn-info btn-sm" ng-click="Download(list.id)">Download</button></td>
                                    </tr>
                                </table>
                            </div>
                        </div> *@

                        <div class="modal-footer">
                            <button type="button" class="btn btn-warning sm" data-bs-dismiss="modal"><i class="fas fa-times-circle"></i></button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>




