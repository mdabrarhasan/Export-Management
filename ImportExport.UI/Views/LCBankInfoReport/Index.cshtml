<script src="~/CustomJS/Report/LCBankInfoReport.js"></script>

<style>
    .select2-container .select2-selection--single {
        height: 37px !important;
        display: flex;
        align-items: center;
    }
</style>

<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

<div ng-app="LCBankInfoReportApp"
     ng-controller="LCBankInfoReportCtl"
     ng-init="LoadApplicants()">

    <div class="row">
        <div class="col-sm-12">
            <div class="card">

                <div class="card-header">
                    <h4 class="card-title mb-0">Party Outstanding Report</h4>
                </div>














                <div class="card-body">
                    <form>

                        <div class="row">
                            <div class="col-md-2">
                                <div class="mb-2">
                                    <label class="form-label">LC No</label>
                                    <input type="text"
                                           class="form-control"
                                           id="txtLcNo"
                                           ng-model="lcNoText"
                                           ng-change="SetLcId()"
                                           list="lcNoSuggestionList"
                                           placeholder="Enter LC No" />

                                    <input type="hidden" ng-model="lcNo" />

                                    <datalist id="lcNoSuggestionList">
                                        <option ng-repeat="item in lcNoList" value="{{item.name}}"></option>
                                    </datalist>
                                </div>
                            </div>

                            <div class="col-md-2">
                                <div class="mb-2">
                                    <label class="form-label">Applicant Name</label>
                                    <select class="form-select"
                                            id="ddlApplicant"
                                            ng-model="applicantId">
                                        <option value="0">-- All Applicants --</option>
                                        <option ng-repeat="item in applicantList" value="{{item.id}}">
                                            {{item.name}}
                                        </option>
                                    </select>
                                </div>
                            </div>

                            <div class="col-md-2">
                                <div class="mb-2">
                                    <label class="form-label">Start Date</label>
                                    <input type="date"
                                           class="form-control"
                                           id="txtStartDate"
                                           ng-model="startDate" />
                                </div>
                            </div>

                            <div class="col-md-2">
                                <div class="mb-2">
                                    <label class="form-label">End Date</label>
                                    <input type="date"
                                           class="form-control"
                                           id="txtEndDate"
                                           ng-model="endDate" />
                                </div>
                            </div>

                            <div class="col-md-2">
                                <div class="mb-2">
                                    <label class="form-label">Payment Date</label>
                                    <input type="date"
                                           class="form-control"
                                           id="txtPaymentDate"
                                           ng-model="paymentDate" />
                                </div>
                            </div>

                            <div class="col-md-2">
                                <div class="mb-2">
                                    <label class="form-label">Bank Name</label>
                                    <select class="form-select"
                                            id="ddlBank"
                                            ng-model="bankId">
                                        <option value="0">-- All Banks --</option>
                                        <option ng-repeat="item in bankList" value="{{item.id}}">
                                            {{item.name}}
                                        </option>
                                    </select>
                                </div>
                            </div>


                        </div>


                        <div class="row">


                            <div class="col-md-2">
                                <div class="mb-2">
                                    <label class="form-label">AM Challan Date</label>
                                    <input type="date"
                                           class="form-control"
                                           id="txtAmChallanDate"
                                           ng-model="amChallanDate" />
                                </div>
                            </div>

                            <div class="col-md-2">
                                <div class="mb-2">
                                    <label class="form-label">Payment Received Date</label>
                                    <input type="date"
                                           class="form-control"
                                           id="txtPaymentReceiveDate"
                                           ng-model="paymentReceiveDate" />
                                </div>
                            </div>

                            <div class="col-md-2">
                                <div class="mb-2">
                                    <label class="form-label">AIT Certificate Status</label>
                                    <select class="form-select"
                                            id="ddlAitCertificateStatus"
                                            ng-model="aitCertificateStatusId">
                                        <option value="0">-- All Status --</option>
                                        <option ng-repeat="item in aitCertificateStatusList" value="{{item.id}}">
                                            {{item.name}}
                                        </option>
                                    </select>
                                </div>
                            </div>

                            <div class="col-md-2">
                                <div class="mb-2">
                                    <label class="form-label">Doc Nego Date</label>
                                    <input type="date"
                                           class="form-control"
                                           id="txtDocNegoDate"
                                           ng-model="docNegoDate" />
                                </div>
                            </div>

                            <div class="col-md-2">
                                <div class="mb-2">
                                    <label class="form-label">RM Name</label>
                                    <select class="form-select"
                                            id="ddlRmName"
                                            ng-model="rmName">
                                        <option value="">-- All RM --</option>
                                        <option ng-repeat="item in rmList" value="{{item.name}}">
                                            {{item.name}}
                                        </option>
                                    </select>
                                </div>
                            </div>

                            <div class="col-md-2">
                                <div class="mb-2">
                                    <label class="form-label">RM Date</label>
                                        @* <select class="form-select"
                                                id="ddlRmDate"
                                                ng-model="rmDate">
                                            <option value="">-- All RM Dates --</option>
                                        <option ng-repeat="item in rmDateList" value="{{item.id}}">
                                            {{item.name}}
                                        </option>
                                        </select> *@
                                    <input type="date"
                                           class="form-control"
                                           id="ddlRmDate"
                                           ng-model="rmDate" />


                                </div>
                            </div>


                        </div>
















                        <div class="row">
                            <div class="col-md-2">
                                <div class="mb-2">
                                    <button style="margin-top:28px;"
                                            type="button"
                                            class="btn btn-primary w-md"
                                            ng-click="Submit()">
                                        Submit
                                    </button>
                                </div>
                            </div>
                        </div>

                    </form>
                </div>



                <div class="row" ng-if="iframeUrl" style="margin-top:20px;">
                    <div class="col-sm-12">

                        <div class="card shadow-sm">
                            <div class="card-header">
                                <h4 class="mb-0">Party Outstanding Report</h4>
                            </div>

                            <div class="card-body p-0">
                                <iframe ng-src="{{iframeUrl}}"
                                        width="100%"
                                        height="1000"
                                        frameborder="0"
                                        style="display:block;">
                                </iframe>
                            </div>
                        </div>

                    </div>
                </div>




            </div>
        </div>
    </div>
</div>