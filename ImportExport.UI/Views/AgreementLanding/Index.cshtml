<script src="~/customjs/agreement/agreementlanding.js"></script>
<script src="~/customjs/common.js"></script>

<div ng-app="App" ng-controller="Ctl">
    <div ng-show="loading">
        <img style="width:70%;height:100%;position:absolute;z-index:1;" src="~/assets/images/Untitled.svg">
    </div>

    <div class="row">
        <div class="col-sm-12">
            <div class="card">

                <!-- HEADER -->
                <div class="card-header">
                    <h4>Agreement Landing Info</h4>
                </div>

                <div class="card-body" style="font-family:'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; font-size:14px;">

                    <!-- TOP BAR -->
                    <div class="row align-items-center mb-3">

                        <!-- LEFT: ADD BUTTON -->
                        <div class="col-md-4 d-flex align-items-center">
                            <button type="button"
                                    class="btn btn-primary btn-sm d-inline-flex align-items-center gap-2 px-3 py-2 shadow-sm"
                                    ng-click="Clear()"
                                    data-bs-toggle="modal"
                                    data-bs-target="#exampleModalFullscreen">
                                <b>
                                    <i class="mdi mdi-plus"></i>
                                    <span>Add New</span>
                                </b>
                            </button>
                        </div>

                        <!-- MIDDLE: AGREEMENT TYPE -->
                        <div class="col-md-4">
                            <select class="form-select"
                                    ng-model="agreementtypeidsearch"
                                    ng-init="AgreementType()"
                                    ng-change="PIList()">
                                <option value="">-- Select Agreement Type --</option>
                                <option ng-repeat="list in Agreementtype" value="{{list.code}}">
                                    {{list.name}}
                                </option>
                            </select>
                        </div>

                        <!-- RIGHT: SEARCH -->
                        <div class="col-md-4">
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="mdi mdi-magnify"></i>
                                </span>

                                <input type="text"
                                       ng-model="search"
                                       class="form-control"
                                       placeholder="Search PI, Customer, SQ...">

                                <button class="btn btn-outline-secondary"
                                        type="button"
                                        ng-click="search=''"
                                        ng-show="search">
                                    <i class="mdi mdi-close"></i>
                                </button>
                            </div>
                        </div>

                    </div>

                    <!-- TABLE -->
                    <div class="table-responsive">
                        <table class="table table-bordered table-hover">

                            <thead class="table-dark">
                                <tr>
                                    <th style="display:none;">ID</th>

                                    <th ng-click='sortBy("PINUMBER")'>PI No</th>
                                    <th ng-click='sortBy("PIDATE")'>PI Date</th>
                                    <th ng-click='sortBy("CUSTOMERNAME")'>Customer</th>
                                    <th ng-click='sortBy("SQNUMBER")'>SQ No</th>
                                    <th ng-click='sortBy("PAYMENTTERM")'>Payment</th>
                                    <th ng-click='sortBy("SHIPMENT")'>Shipment</th>
                                    <th ng-click='sortBy("FROMSHIPMENTCOUNTRY")'>From</th>
                                    <th ng-click='sortBy("TOSHIPMENTCOUNTRY")'>To</th>
                                    <th ng-click='sortBy("INTOTERM")'>Inco Term</th>
                                    <th ng-click='sortBy("documentcreateddate")'>Created</th>
                                    <th>Status</th>
                                    <th class="text-center">Action</th>
                                </tr>
                            </thead>

                            <tbody>
                                <tr dir-paginate="list in PIlist | orderBy:sortColumn:reverse | filter:search | itemsPerPage:pageSize"
                                    current-page="currentPage">

                                    <td style="display:none;">{{list.agreementid}}</td>

                                    <td>
                                        <a href="" ng-click="Report(list.pinumber)">
                                            {{list.pinumber}}
                                        </a>
                                    </td>

                                    <td>{{list.pidate}}</td>
                                    <td>{{list.customername}}</td>
                                    <td>{{list.sqnumber}}</td>
                                    <td>{{list.paymentterm}}</td>
                                    <td>{{list.shipment}}</td>
                                    <td>{{list.fromshipmentcountry}}</td>
                                    <td>{{list.toshipmentcountry}}</td>
                                    <td>{{list.intoterm}}</td>
                                    <td>{{list.documentcreateddate}}</td>

                                    <!-- STATUS BADGES -->
                                    <td>
                                        <span class="badge rounded-pill badge-soft-info" ng-if='list.code=="PEND"'>{{list.dosstatus}}</span>
                                        <span class="badge rounded-pill badge-soft-success" ng-if='list.code=="APPR"'>{{list.dosstatus}}</span>
                                        <span class="badge rounded-pill badge-soft-danger" ng-if='list.code=="REJC"'>{{list.dosstatus}}</span>
                                        <span class="badge rounded-pill badge-soft-primary" ng-if='list.code=="COMP"'>{{list.dosstatus}}</span>
                                    </td>

                                    <!-- ACTION BUTTONS -->
                                    <td class="text-center">

                                        <button class="btn btn-info btn-sm"
                                                data-bs-toggle="modal"
                                                data-bs-target="#ViewexampleModalFullscreen"
                                                ng-click="ViewByMasterID(list.agreementid,list.agreementtypeid)">
                                            <i class="fas fa-search-plus"></i>
                                        </button>

                                        <button class="btn btn-info btn-sm"
                                                
                                                data-bs-toggle="modal"
                                                data-bs-target="#EditexampleModalFullscreen"
                                                ng-click="EditbyMasterID(list.agreementid,list.pinumber)">
                                            <i class="fas fa-edit"></i>
                                        </button>

                                        <button class="btn btn-danger btn-sm"
                                                ng-disabled="list.flag==1"
                                                ng-click="DeleteMaster(list.agreementid,list.agreementtypeid)">
                                            <i class="fas fa-trash"></i>
                                        </button>

                                    
                                        <button type="button"
                                                class="btn btn-success btn-sm"
                                                ng-click="ContractReport(list.agreementid)">
                                            <i class="fas fa-file-alt"></i>
                                        </button>
                                    

                                        @* <button class="btn btn-secondary btn-sm"
                                                ng-disabled="list.isprocessedwithapproval==true"
                                                ng-click="Cancled(2,list.agreementid)">
                                            <i class="fas fa-ban"></i>
                                        </button> *@

                                    </td>
                                </tr>
                            </tbody>

                        </table>
                    </div>

                    <!-- PAGINATION INIT -->
                    <div ng-init="currentPage=1; pageSize=8"></div>

                    <!-- PAGINATION STYLE -->
                    <style>
                        dir-pagination-controls ul {
                            display: flex;
                            justify-content: center;
                            gap: 6px;
                            padding-left: 0;
                            margin-top: 20px;
                        }

                        dir-pagination-controls li {
                            list-style: none;
                        }

                            dir-pagination-controls li a {
                                padding: 8px 14px;
                                border-radius: 8px;
                                background: #f8f9fa;
                                color: #0d6efd;
                                transition: 0.25s;
                            }

                                dir-pagination-controls li a:hover {
                                    background: #e7f1ff;
                                }

                            dir-pagination-controls li.active a {
                                background: #0d6efd;
                                color: #fff;
                            }

                            dir-pagination-controls li.disabled a {
                                background: #e9ecef;
                                color: #aaa;
                            }
                    </style>

                    <!-- FOOTER -->
                    <div class="row mt-2 align-items-center">

                        <div class="col-md-4">
                            <span style="font-size:13px; font-weight:600; opacity:0.7;">
                                Total Records:
                                <b>{{ (PIlist | filter:search).length }}</b>
                            </span>
                        </div>

                        <div class="col-md-4 text-center">
                            <dir-pagination-controls direction-links="true"
                                                     boundary-links="true"
                                                     current-page="currentPage">
                            </dir-pagination-controls>
                        </div>

                        <div class="col-md-4"></div>

                    </div>

                </div>
            </div>
        </div>
    </div>

    <div id="exampleModalFullscreen" class="modal fade" tabindex="-1" aria-labelledby="exampleModalFullscreenLabel" aria-hidden="true">
        <div class="modal-dialog modal-fullscreen">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="myExtraLargeModalLabel">Agreement (Insertion Mode)</h5>
                    <h4 style="text-align:center;color:red;margin-left:35%" id="cusname"></h4>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>


                <div class="modal-body">
                    <form class="needs-validation" novalidate>
                        <input type="hidden" id="editsqnumber" />
                        <input type="hidden" id="hitemid" />
                        <input type="hidden" id="especificid" />
                        <input type="hidden" id="unitid" />

                        <div class="row">
                            <div class="col-sm-4">
                                <label>Select Type :</label>
                                <select class="typeid form-select" ng-model="typeid" ng-change="TypeChange()" id="typeid">
                                    <option value="">--Select--</option>
                                    <option value="1">
                                        SQ
                                    </option>
                                    <option value="2">
                                        PI
                                    </option>
                                </select>
                                <span class="error">Select Type </span>
                            </div>

                            <div class="col-sm-4">
                                <label>Select Sales Quotation :</label>
                                <select class="sqid form-select" ng-model="sqid" ng-init="GetSalesQuotation(0)" ng-change="GetSalesQuotationInsertionMode()"
                                        id="sqid">
                                    <option value="">--Select--</option>
                                    <option ng-repeat="list in quotationlist" value="{{list.id}}">
                                        {{list.name}}
                                    </option>
                                </select>
                                <span class="error">Select SQ Number </span>
                            </div>


                            <div class="col-sm-4">
                                <label>Agreement Type :</label>
                                <select class="form-select" ng-model="agreementtypeid" ng-init="AgreementType()" ng-change="PIList()"
                                        id="agreementtypeid">
                                    <option value="">--Select--</option>
                                    <option ng-repeat="list in Agreementtype" value="{{list.code}}">
                                        {{list.name}}
                                    </option>
                                </select>
                                <span class="error">Select Agreement Type</span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-sm-12">
                                <div class="card">
                                    <div class="card-header">
                                        <h6>PI Details</h6>
                                    </div>
                                    <div class="card-body">
                                        <input type="hidden" id="sqidhidden" />

                                        <!-- Hidden fields kept in DOM -->
                                        <div style="display:none">
                                            <label>Tarrif Code :</label>
                                            <input type="text" id="txtTariffCode" class="form-control" />
                                            <input type="text" id="txtTariffCodehidden" class="form-control" />
                                            <input type="text" id="ehsellerid" class="form-control" />

                                            <label>Seller HS Code :</label>
                                            <input class="hscode form-control" type="text" id="txtHSCode" ng-keyup="GetHSCode(0)" placeholder="Search HS Code..." autocomplete="off">

                                            <label>Buyer HS Code :</label>
                                            <input class="hbuyerscode form-control" type="text" id="txtBuyerHSCode">
                                        </div>

                                        <!-- Row 1 -->
                                        <div class="row">
                                            <div class="col">
                                                <label>Date :</label>
                                                <input type="date" class="form-control date" id="txtDate">
                                                <span class="error">Date Required</span>
                                            </div>
                                            <div class="col">
                                                <label>Expire Date :</label>
                                                <input type="date" class="form-control" id="txtExpireDate">
                                                <span class="error">Expire Date Required</span>
                                            </div>
                                            <div class="col">
                                                <label>Shipment Date :</label>
                                                <input type="date" id="txtShipmentDate" class="form-control" />
                                                <span class="error">Select Shipment Date</span>
                                            </div>
                                            <div class="col">
                                                <label>Delivery By :</label>
                                                <select class="deliveryby form-select" ng-model="deliveryby" ng-init="GETLOADINGBY()"
                                                        id="deliveryby">
                                                    <option value="">--Select--</option>
                                                    <option ng-repeat="list in deliverybylist" value="{{list.id}}">
                                                        {{list.name}}
                                                    </option>
                                                </select>
                                                <span class="error">deliveryby Required</span>
                                            </div>
                                            <div class="col">
                                                <label>Buyer Contract No :</label>
                                                <input type="text" class="form-control" id="txtBuyerRegNo" />
                                                <span class="error">Buyer Contract No</span>
                                            </div>
                                            <div class="col">
                                                <label>Order Confirm Date :</label>
                                                <input type="date" class="form-control" id="txtOrderDate" />
                                                <span class="error">Order Date Required</span>
                                            </div>
                                            <div class="col">
                                                <label>Notify Party :</label>
                                                <input type="text" class="form-control" id="txtNotifyParty" />
                                                <span class="error">Notify Party Required.</span>
                                            </div>
                                            <div class="col">
                                                <label>Partial Shipment :</label>
                                                <select class="txtpartialshipment form-select" ng-model="txtpartialshipmentid" ng-init="GetConfirm()"
                                                        id="txtpartialshipmentid">
                                                    <option value="">--Select--</option>
                                                    <option ng-repeat="list in loadconfirm" value="{{list.id}}">
                                                        {{list.name}}
                                                    </option>
                                                </select>
                                                <span class="error">Select Payment Term</span>
                                            </div>
                                        </div>

                                        <!-- Row 2 -->
                                        <div class="row mt-2">
                                            <div class="col">
                                                <label>Seller Bank :</label>
                                                <select class="sellerbankid form-select" ng-model="sellerbankid" ng-init="SellerBankInfo()"
                                                        id="sellerbankid">
                                                    <option value="">--Select--</option>
                                                    <option ng-repeat="list in sellerbanklist" value="{{list.id}}">
                                                        {{list.name}}
                                                    </option>
                                                </select>
                                                <span class="error">Select Seller Bank</span>
                                            </div>
                                            <div class="col">
                                                <label>Buyer Bank :</label>
                                                <input type="text" class="form-control" id="txtBuyerBank" />
                                                <span class="error">Buyer Bank Required</span>
                                            </div>
                                            <div class="col">
                                                <label>Trans-shipment :</label>
                                                <select class="transhipment form-select" ng-model="transhipmentid" ng-init="GetConfirm()"
                                                        id="transhipmentid">
                                                    <option value="">--Select--</option>
                                                    <option ng-repeat="list in loadconfirm" value="{{list.id}}">
                                                        {{list.name}}
                                                    </option>
                                                </select>
                                                <span class="error">Select Trans-shipment</span>
                                            </div>
                                            <div class="col">
                                                <label>Incoterms :</label>
                                                <select class="txtincotermid form-select" ng-model="txtincotermid" ng-init="GetIncoTerm()"
                                                        id="txtincotermid">
                                                    <option value="">--Select--</option>
                                                    <option ng-repeat="list in incotermlist" value="{{list.id}}">
                                                        {{list.name}}
                                                    </option>
                                                </select>
                                                <span class="error">Select Inco Terms</span>
                                            </div>
                                            <div class="col">
                                                <label>Loading Place :</label>
                                                <input class="loadingplace form-control" disabled type="text" id="loadingplace">
                                            </div>
                                            <div class="col">
                                                <label>Currency :</label>
                                                <select class="txtcurrencyid form-select" ng-model="txtcurrencyid" disabled ng-init="GetCurrency()"
                                                        id="txtcurrencyid">
                                                    <option value="">--Select--</option>
                                                    <option ng-repeat="list in currencylist" value="{{list.id}}">
                                                        {{list.name}}
                                                    </option>
                                                </select>
                                            </div>
                                            <div class="col">
                                                <label>Shipment Mode :</label>
                                                <select class="sqid form-select" disabled ng-model="txtshipmentmodeid" ng-init="GetShipmentMode()"
                                                        id="txtshipmentmodeid">
                                                    <option value="">--Select--</option>
                                                    <option ng-repeat="list in shipmentmodelist" value="{{list.id}}">
                                                        {{list.name}}
                                                    </option>
                                                </select>
                                            </div>
                                            <div class="col">
                                                <label>From Shipment :</label>
                                                <select class="txtFromshipmentcountryid form-select" disabled ng-model="txtFromshipmentcountryid" ng-init="GetShipmentCountry()" ng-change="VatCal()"
                                                        id="txtFromshipmentcountryid">
                                                    <option value="">--Select--</option>
                                                    <option ng-repeat="list in shipmentcountrylist" value="{{list.id}}">
                                                        {{list.name}}
                                                    </option>
                                                </select>
                                            </div>
                                        </div>

                                        <!-- Row 3 -->
                                        <div class="row mt-2">
                                            @* <div class="col">
                                                <label>To Shipment :</label>
                                                <input type="text" class="form-control" ng-model="Freetextshipid" id="Freetextshipid" disabled />
                                            </div> *@
                                            <div class="col">
                                                <label>To Shipment Country :</label>
                                                <select class="txtToshipmentcountryid form-select" disabled
                                                        ng-model="txtToshipmentcountryid"
                                                        ng-init="GetToShipmentCountry()"
                                                        id="txtToshipmentcountryid">
                                                    <option value="">--Select--</option>
                                                    <option ng-repeat="list in toshipmentcountrylist" value="{{list.id}}">
                                                        {{list.name}}
                                                    </option>
                                                </select>
                                                <span class="error">Select To Shipment Country</span>
                                            </div>
                                            
                                            <div class="col">
                                                <label>Loading Port :</label>
                                                <select class="txtloadingport form-select" disabled 
                                                        ng-model="txtloadingport" 
                                                        ng-init="GetLoadingport()" 
                                                        ng-change="VatCal()"
                                                        id="txtloadingport">
                                                    <option value="">--Select--</option>
                                                    <option ng-repeat="list in loadingportlist" value="{{list.id}}">
                                                        {{list.name}}
                                                    </option>
                                                </select>
                                            </div>
                                            <div class="col">
                                                <label>Destination Port :</label>
                                                <input type="text" class="txtTEXTDESTINATIONPORT form-control" ng-model="txtTEXTDESTINATIONPORT" id="txtTEXTDESTINATIONPORT" placeholder="Destination Port" readonly />
                                            </div>
                                            
                                            <div class="col">
                                                <label>Country of Origin :</label>
                                                <input type="text" class="form-control" value="Bangladesh" disabled id="txtOriginCountry" />
                                            </div>
                                            <div class="col">
                                                <label>Payment Terms :</label>
                                                <input type="text" class="form-control" id="txtpaymenttermid" disabled />
                                                <input type="hidden" id="txtpaymenttermidval" />
                                            </div>
                                            <div class="col"></div>
                                            <div class="col"></div>
                                            <div class="col"></div>
                                        </div>

                                    </div>
                                </div>
                            </div>
                        </div>
                
                       <div class="card">
                        <div class="card-header">
                            <h4>Add Item</h4>
                        </div>
                            <div class="card-body">
                                <div class="row table-responsive">
                                    <table class="table table-bordered">
                                        <tr>
                                            <th>Item Type</th>
                                            <th>Item Name</th>

                                            <th style="color:#5dade2">Size</th>
                                            <th style="color:#5dade2">Construction</th>
                                            <th style="color:#5dade2">Weight</th>

                                            <th style="color:#5dade2">Slit</th>
                                            <th style="color:#5dade2">Scrim</th>

                                            <th style="color:red">Quality</th>
                                            <th>Item Title</th>
                                            <th>Packing Details</th>
                                            <th>UOM</th>
                                            <th>Quantity</th>
                                            <th>Unit Price</th>
                                            <th>Discount%</th>
                                            <th>Dis. Amount</th>
                                            <th>Total Amount</th>
                                            <th>Short Details</th>

                                            <th>Action</th>
                                        </tr>

                                        <tr class="mycontainer" id="mainrow">
                                            <td style="width:120px">
                                                <select style="width:120px" class="itemtypeid form-select" ng-model="itemtypeid" ng-init="GetItemType()" ng-change="EnableDisableItemTypeWise()"
                                                        id="itemtypeid">
                                                    <option value="">--Select--</option>
                                                    <option ng-repeat="list in itemtype" value="{{list.id}}">
                                                        {{list.name}}
                                                    </option>
                                                </select>
                                                <span class="error">Select Type</span>
                                            </td>

                                            <td style="width:350px">
                                                <input type="hidden" id="itemcode" class="itemcode form-control" />
                                                <input type="hidden" id="hname" />
                                                <input style="width:350px" class="name form-control" type="text" id="name" ng-keyup="SearchFGHeader()" placeholder="Search Item..." autocomplete="off">
                                                <span class="error">Select Item</span>
                                            </td>


                                            <td>
                                                <input type="hidden" id="txtSizeID" class="txtSizeID" />
                                                <input style="width:100px" type="text" id="txtSize" class="txtSize form-control" ng-keyup="SearchSize()" ng-paste="SearchSize()" />
                                            </td>

                                            <td>
                                                <input type="hidden" id="txtConstructionID" class="txtConstructionID" />
                                                <input style="width:100px" type="text" id="txtConstruction" class="txtConstruction form-control" ng-keyup="SearchContruction()" ng-paste="SearchContruction()" />
                                            </td>

                                            <td>
                                                <input type="hidden" id="txtWeightID" class="txtWeightID" />
                                                <input style="width:100px" type="text" id="txtWeight" class="txtWeight form-control" ng-keyup="SearchWeight()" ng-paste="SearchWeight()" />
                                            </td>

                                            <td>
                                                <input type="hidden" id="txtSlitID" class="txtSlitID" />
                                                <input style="width:100px" type="text" id="txtSlit" class="txtSlit form-control" ng-keyup="SearchSlit()" ng-paste="SearchSlit()" />
                                            </td>

                                            <td>
                                                <input type="hidden" id="txtScrimID" class="txtScrimID" />
                                                <input style="width:100px" type="text" id="txtScrim" class="txtScrim form-control" ng-keyup="SearchScrim()" ng-paste="SearchScrim()" />
                                            </td>
                                            <td>
                                                <input type="hidden" id="txtQualityID" class="txtQualityID" />
                                                <input style="width:100px" type="text" id="txtQuality" class="txtQuality form-control" ng-keyup="SearchQuality()" ng-paste="SearchQuality()" />
                                            </td>


                                            <td><input style="width:150px" type="text" id="txtItemTitle" class="txtItemTitle form-control" /></td>
                                            <td>
                                                <input style="width:150px" type="text" id="packingdetails" class="packingdetails form-control" />
                                            </td>


                                            <td>
                                                <select style="width:100px" class="uomid form-select" ng-model="UOMID"
                                                        id="uomid">
                                                    <option value="">--Select--</option>
                                                    <option ng-repeat="list in uomlist" value="{{list.id}}">
                                                        {{list.name}}
                                                    </option>
                                                </select>
                                                <span class="error">Select UOM</span>
                                            </td>


                                            <td>
                                                <input style="width:100px" type="text" id="quantity" value="0" class="quantity form-control" ng-keyup="Calculate()" onkeypress="return isNumber($event)" />
                                                <span class="error">could not be zero</span>
                                            </td>

                                            <td style="width:100px">
                                                <input type="hidden" id="hvatvalue" class="hunitprice form-control" />
                                                <input style="width:120px" type="text" id="unitprice" value="0" class="unitprice form-control" ng-keyup="Calculate()" onkeypress="return isNumber($event)" />
                                                <span class="error">could not be zero</span>
                                            </td>


                                            <td>
                                                <select style="width:100px" class="discountid form-select" ng-model="DiscountID" ng-init="Dislist()" ng-change="DisCal()"
                                                        id="discountid">
                                                    <option value="">--Select Dis--</option>
                                                    <option ng-repeat="list in Dislist" value="{{list.id}}">
                                                        {{list.disName}}
                                                    </option>
                                                </select>
                                                <span class="error">Select Discount</span>
                                            </td>


                                            <td>
                                                <input type="text" id="discountamount" value="0" class="discountamount form-control" ng-keyup="Calculate()" disabled />
                                            </td>

                                            <td>
                                                <input style="width:100px" type="text" id="totalamount" value="0" class="totalamount form-control" disabled />
                                                <span class="error">could not be zero</span>
                                            </td>

                                            <td>
                                                <input style="width:200px" type="text" id="remarks" class="remarks form-control" />
                                            </td>
                                            <td>
                                                <button type="button" id="add" value="add" ng-click="Add()" class="btn btn-info btn-sm"><i class="fas fa-ad"></i></button>
                                            </td>
