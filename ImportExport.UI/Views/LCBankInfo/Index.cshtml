<script src="~/customjs/lcbankinfo/lcbankinfo.js"></script>
<div ng-app="App" ng-controller="Ctl" ng-init="LoadData()">
    <div ng-show="loading">
        <img style="width:50%;height:100%;position:absolute;z-index:1;" src="~/assets/images/Untitled.svg">
    </div>

    <div class="row">
        <div class="col-sm-12">
            <div class="card">

                <!-- HEADER -->
                <div class="card-header">
                    <h4>LC Bank Info</h4>
                </div>

                <!-- BODY -->
                <div class="card-body" style="font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; font-size:14px;">

                    <!-- TOP BAR -->
                    <div class="row align-items-center mb-3">

                        <!-- LEFT: ADD BUTTON -->
                        <div class="col-md-6 d-flex align-items-center">
                            <button type="button"
                                    class="btn btn-primary btn-sm d-inline-flex align-items-center gap-2 px-3 py-2 shadow-sm"
                                    ng-click="Clear()"
                                    data-bs-toggle="modal"
                                    data-bs-target="#exampleModalFullscreen">
                                <b>
                                    <i class="mdi mdi-plus"></i>
                                    <span>Add New</span>
                                </b>
                            </button>
                        </div>

                        <!-- RIGHT: SEARCH -->
                        <div class="col-md-6">
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="mdi mdi-magnify"></i>
                                </span>

                                <input type="text"
                                       ng-model="search"
                                       class="form-control"
                                       placeholder="Search LC No, IDPB/IDBC..."
                                       ng-change="onSearchChange()">

                                <button class="btn btn-outline-secondary"
                                        type="button"
                                        ng-click="search=''"
                                        ng-show="search">
                                    <i class="mdi mdi-close"></i>
                                </button>
                            </div>
                        </div>

                    </div>

                    <!-- TABLE -->
                    <div class="table-responsive">
                        <table id="tblinfo" class="table table-bordered table-hover">

                            <thead class="table-dark">
                                <tr>
                                    <th style="display:none;">ID</th>

                                    <th ng-click='sortBy("lcnumber")'>
                                        LC Number
                                    </th>

                                    <th ng-click='sortBy("")'> @* *@
                                        Invoice No
                                    </th>

                                    <th ng-click='sortBy("docnegotiatedate")'>
                                        Doc Negotiate Date
                                    </th>

                                    <th ng-click='sortBy("beneficiarybankcost")'>
                                        Beneficiary Bank Cost
                                    </th>

                                    <th ng-click='sortBy("crossbankcharge")'>
                                        Cross Bank Charge
                                    </th>

                                    <th ng-click='sortBy("paymentreceivedate")'>
                                        Payment Receive Date
                                    </th>

                                    <th ng-click='sortBy("idpbidbcno")'>
                                        IDPB/IDBC No
                                    </th>

                                    <th ng-click='sortBy("status")'>
                                        Status
                                    </th>

                                    <th style="text-align:center;">
                                        Action
                                    </th>
                                </tr>
                            </thead>

                            <tbody>
                                <tr dir-paginate="list in BankInfoList | orderBy: sortColumn : reverse | filter:search | itemsPerPage: pageSize"
                                    current-page="currentPage">

                                    <td style="display:none;">{{list.id}}</td>

                                    <td>{{list.lcnumber}}</td>
                                    <td>{{list.invoiceno}}</td>
                                    <td>{{list.docnegotiatedate}}</td>
                                    <td style="text-align:left;">{{list.beneficiarybankcost}}</td>
                                    <td style="text-align:left;">{{list.crossbankcharge}}</td>
                                    <td>{{list.paymentreceivedate}}</td>
                                    <td>{{list.idpbidbcno}}</td>
                                    <td>{{list.status}}</td>

                                    <td class="text-center">

                                        <button type="button"
                                                class="btn btn-info btn-sm"
                                                data-bs-toggle="modal"
                                                data-bs-target="#ViewexampleModalFullscreen"
                                                ng-click="ViewMaster(list)">
                                            <i class="fas fa-search-plus"></i>
                                        </button>

                                        <button type="button"
                                                class="btn btn-info btn-sm"
                                                ng-disabled='list.code=="COMP"'
                                                data-bs-toggle="modal"
                                                data-bs-target="#EditexampleModalFullscreen"
                                                ng-click="EditMaster(list)">
                                            <i class="fa fa-edit"></i>
                                        </button>

                                        <button type="button"
                                                class="btn btn-danger btn-sm"
                                                ng-click="DeleteMaster(list.id)">
                                            <i class="fas fa-trash"></i>
                                        </button>

                                    </td>
                                </tr>
                            </tbody>

                        </table>
                    </div>

                    <div ng-init="currentPage=1; pageSize=10"></div>
                    <style>
                        /* Pagination container */
                        dir-pagination-controls ul {
                            display: flex;
                            justify-content: center;
                            align-items: center;
                            gap: 6px;
                            padding-left: 0;
                            margin-top: 20px;
                        }

                        /* Pagination items */
                        dir-pagination-controls li {
                            list-style: none;
                        }

                            /* Links */
                            dir-pagination-controls li a {
                                display: inline-block;
                                padding: 8px 14px;
                                border-radius: 8px;
                                background: #f8f9fa;
                                color: #0d6efd;
                                font-weight: 500;
                                border: 1px solid transparent;
                                transition: all 0.25s ease;
                            }

                                /* Hover effect */
                                dir-pagination-controls li a:hover {
                                    background: #e7f1ff;
                                    border-color: #0d6efd;
                                    text-decoration: none;
                                }

                            /* Active page */
                            dir-pagination-controls li.active a {
                                background: #0d6efd;
                                color: #fff;
                                border-color: #0d6efd;
                                box-shadow: 0 2px 6px rgba(13, 110, 253, 0.3);
                            }

                            /* Disabled state */
                            dir-pagination-controls li.disabled a {
                                background: #e9ecef;
                                color: #adb5bd;
                                cursor: not-allowed;
                            }

                            /* Optional: subtle click animation */
                            dir-pagination-controls li a:active {
                                transform: scale(0.95);
                            }
                    </style>
                    <div class="row mt-2 align-items-center">

                        <!-- LEFT: Total Records -->
                        <div class="col-md-4">
                            <span style="font-size:13px; font-weight:600; color:#444; letter-spacing:0.3px; opacity:0.75;">
                                Total Records:
                                <span style="color:#444; font-weight:700;">
                                    {{ (BankInfoList | filter:search).length }}
                                </span>
                            </span>
                        </div>

                        <!-- CENTER: Pagination -->
                        <div class="col-md-4 text-center">

                            <dir-pagination-controls direction-links="true"
                                                     max-size="10"
                                                     boundary-links="true"
                                                     current-page="currentPage">
                            </dir-pagination-controls>

                        </div>

                        <!-- RIGHT: empty for balance -->
                        <div class="col-md-4"></div>

                    </div>

                </div>
            </div>
        </div>
    </div>




    <!-- Modal for Insertion -->
    <div id="exampleModalFullscreen" class="modal fade" tabindex="-1" aria-labelledby="exampleModalFullscreenLabel" aria-hidden="true">
        <div class="modal-dialog modal-fullscreen">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="myExtraLargeModalLabel">LC Bank Info (Insertion Mode)</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form class="needs-validation" novalidate>
                        <div class="row">
                            <div class="col-sm-3">
                                <label>Search LC No:</label>
                                <input type="text" class="form-control" ng-keyup="LCNO()" ng-paste="LCNO()" id="txtLCNo" placeholder="Search LC..." autocomplete="off"  />
                                <input type="text" hidden class="form-control" id="txtLCNOID" />
                                <span class="error">LC No Required</span>
                            </div>
                            <!-- INVOICE DROPDOWN -->
                            <div class="col-sm-3">
                                <label>Invoice No:</label>
                                <select class="form-control" ng-model="bankinvoiceid"
                                        id="bankinvoiceid">
                                    <option value="">--Select--</option>
                                    <option ng-repeat="list in invoiceList" value="{{list.id}}" >
                                        {{list.name}}
                                    </option>
                                </select>

   


                                <span class="error">Invoice No Required</span>
                            </div>
                            <div class="col-sm-3">
                                <label>Doc Negotiate Date :</label> 
                                <input type="date" class="form-control" id="txtDocNegotiateDate" />
                                <span class="error">Doc Negotiate Date Required</span>
                            </div>
                            <div class="col-sm-3">
                                <label>Beneficiary Bank Cost :</label>
                                <input type="number" step="0.01" class="form-control" id="txtBeneficiaryBankCost" placeholder="0.00" />
                                <span class="error">Beneficiary Bank Cost Required</span>
                            </div>
                        </div>
                        <br />

                        <div class="row">
                            <div class="col-sm-3">
                                <label>Cross Bank Charge :</label> 
                                <input type="number" step="0.01" class="form-control" id="txtCrossBankCharge" placeholder="0.00" />
                                <span class="error">Cross Bank Charge Required</span>
                            </div>
                            <div class="col-sm-3">
                                <label>Exchange Rate :</label>
                                <input type="number" step="0.01" class="form-control" id="txtExchangeRate" placeholder="1.00" value="1"/>

                            </div>
                            <div class="col-sm-3">
                                <label>Payment Receive Date :</label>
                                <input type="date" class="form-control" id="txtPaymentReceiveDate" />
                                <span class="error">Payment Receive Date Required</span>
                            </div>
                            <div class="col-sm-3">
                                <label>Bank Acceptance :</label>
                                <input type="date" class="form-control" id="txtBankAcceptance" />

                            </div>
                        </div>

                        <div class="row">
                            <div class="col-sm-4">
                                <label>IDPB/IDBC No :</label>
                                <input type="text" class="form-control" id="txtIdpBidBcNo" placeholder="Enter IDP/BID/BC No..." />
                                <span class="error">IDPB/IDBC No Required</span>
                            </div>
                        @* </div>


                        <br />
                        <div class="row"> *@
                            <div class="col-sm-4">
                                <label>Financial Cost Rate :</label>
                                <input type="number"
                                       step="0.01"
                                       class="form-control"
                                       id="txtFinancialCostRate"
                                       placeholder="0.00"
                                       value="0.00" />
                            </div>

                            <div class="col-sm-4">
                                <label>Status :</label>
                                <select class="form-control" id="txtStatus">
                                    <option value="">--Select--</option>
                                    <option value="{{x.name}}" ng-repeat="x in statusList">
                                        {{x.name}}
                                    </option>
                                </select>
                            </div>



                        </div>



                        <div class="modal-footer">
                            <button type="button" ng-click="Clear()" class="btn btn-warning" data-bs-dismiss="modal">
                                <i class="fas fa-times-circle"></i>
                            </button>
                            <button ng-click="Save()" id="savebutton" type="button" class="btn btn-success">
                                <i class="fas fa-check"></i>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal for Edit -->
    <div id="EditexampleModalFullscreen" class="modal fade" tabindex="-1" aria-labelledby="EditexampleModalFullscreenLabel" aria-hidden="true">
        <div class="modal-dialog modal-fullscreen">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="EditexampleModalFullscreenLabel">LC Bank Info (Edit Mode)</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form class="needs-validation" novalidate>
                        <div class="row">
                            <div class="col-sm-3">
                                <label>Search LC No:</label>
                                <input type="text" class="form-control" @*ng-keyup="LCNOEdit()" ng-paste="LCNOEdit()"*@ id="etxtLCNo" @*placeholder="Search LC..." autocomplete="off"*@ disabled />
                                <input type="text" hidden class="form-control" id="etxtLCNOID" />
                                <input type="hidden" id="etxtID" />
                                <span class="error">LC No Required</span>
                            </div>
                            <div class="col-sm-3">
                                <label>Invoice No:</label>
                                <select class="form-control" ng-model="ebankinvoiceid" id="ebankinvoiceid">
                                    <option value="">--Select--</option>
                                    <option ng-repeat="list in editInvoiceList" value="{{list.id}}">
                                        {{list.name}}
                                    </option>
                                </select>
                                <span class="error">Invoice No Required</span>
                            </div>
                            <div class="col-sm-3">
                                <label>Doc Negotiate Date :</label>
                                <input type="date" class="form-control" id="etxtDocNegotiateDate" />
                                <span class="error">Doc Negotiate Date Required</span>
                            </div>
                            <div class="col-sm-3">
                                <label>Beneficiary Bank Cost :</label>
                                <input type="number" step="0.01" class="form-control" id="etxtBeneficiaryBankCost" placeholder="0.00" />
                                <span class="error">Beneficiary Bank Cost Required</span>
                            </div>
                        </div>
                        <br />
                        <div class="row">
                            <div class="col-sm-3">
                                <label>Cross Bank Charge :</label>
                                <input type="number" step="0.01" class="form-control" id="etxtCrossBankCharge" placeholder="0.00" />
                                <span class="error">Cross Bank Charge Required</span>
                            </div>
                            <div class="col-sm-3">
                                <label>Exchange Rate :</label>
                                <input type="number" class="form-control" id="etxtExchangeRate" placeholder="0.00" />

                            </div>
                            <div class="col-sm-3">
                                <label>Payment Receive Date :</label>
                                <input type="date" class="form-control" id="etxtPaymentReceiveDate" />
                                <span class="error">Payment Receive Date Required</span>
                            </div>
                            <div class="col-sm-3">
                                <label>Bank Acceptance :</label>
                                <input type="date" class="form-control" id="etxtBankAcceptance" />

                            </div>
                           
                        </div>

                        <div class="row">
                            <div class="col-sm-4">
                                <label>IDPB/IDBC No :</label>
                                <input type="text" class="form-control" id="etxtIdpBidBcNo" placeholder="Enter IDP/BID/BC No..." />
                                <span class="error">IDPB/IDBC No Required</span>
                            </div>
                        @* </div>


                        <br />
                        <div class="row"> *@
                            <div class="col-sm-4">
                                <label>Financial Cost Rate :</label>
                                <input type="number" step="0.01" class="form-control" id="etxtFinancialCostRate" placeholder="0.00" />
                            </div>


                            <div class="col-sm-4">
                                <label>Status :</label>
                                <select class="form-control" id="etxtStatus" ng-model="editStatus">
                                    <option value="">--Select--</option>
                                    <option value="{{x.name}}" ng-repeat="x in statusList">
                                        {{x.name}}
                                    </option>
                                </select>
                            </div>

                        </div>



                        <div class="modal-footer">
                            <button type="button" ng-click="Clear()" class="btn btn-warning" data-bs-dismiss="modal">
                                <i class="fas fa-times-circle"></i>
                            </button>
                            <button ng-click="UpdateEdit()" id="esavebutton" type="button" class="btn btn-success">
                                <i class="fas fa-check"></i>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal for View -->
    <div id="ViewexampleModalFullscreen" class="modal fade" tabindex="-1" aria-labelledby="ViewexampleModalFullscreenLabel" aria-hidden="true">
        <div class="modal-dialog modal-fullscreen">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="ViewexampleModalFullscreenLabel">LC Bank Info (View Mode)</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form class="needs-validation" novalidate>
                        <div class="row">
                            <div class="col-sm-3">
                                <label>Search LC No:</label>
                                <input type="text" class="form-control" id="vtxtLCNo" placeholder="Search LC..." autocomplete="off" readonly />
                            </div>
                            <div class="col-sm-3">
                                <label>Invoice No:</label>
                                <input type="text" class="form-control" id="vtxtInvoiceNo" placeholder="Invoice No" readonly />
                            </div>
                            <div class="col-sm-3">
                                <label>Doc Negotiate Date :</label>
                                <input type="date" class="form-control" id="vtxtDocNegotiateDate" readonly />
                            </div>
                            <div class="col-sm-3">
                                <label>Beneficiary Bank Cost :</label>
                                <input type="number" step="0.01" class="form-control" id="vtxtBeneficiaryBankCost" placeholder="0.00" readonly />
                            </div>
                        </div>
                        <br />
                        <div class="row">
                            <div class="col-sm-4">
                                <label>Cross Bank Charge :</label>
                                <input type="number" step="0.01" class="form-control" id="vtxtCrossBankCharge" placeholder="0.00" readonly />
                            </div>
                            <div class="col-sm-4">
                                <label>Exchange Rate :</label>
                                <input type="number" step="0.01" class="form-control" id="vtxtExchangeRate" placeholder="0.00" readonly/>

                            </div>
                            <div class="col-sm-4">
                                <label>Payment Receive Date :</label>
                                <input type="date" class="form-control" id="vtxtPaymentReceiveDate" readonly />
                            </div>
                            <div class="col-sm-4">
                                <label>Bank Acceptance :</label>
                                <input type="date" class="form-control" id="vtxtBankAcceptance" readonly/>

                            </div>
                            <div class="col-sm-4">
                                <label>IDPB/IDBC No :</label>
                                <input type="text" class="form-control" id="vtxtIdpBidBcNo" placeholder="Enter IDP/BID/BC No..." readonly />
                            </div>






                        </div>

                        <div class="modal-footer">
                            <button type="button" class="btn btn-warning" data-bs-dismiss="modal">
                                <i class="fas fa-times-circle"></i>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

