    <h1>Report Viewer</h1>
    <iframe ng-src="{{iframeUrl}}" width="100%" height="1000px" class="border rounded"></iframe>
</div>

<script>
    var app = angular.module('App', []);
    app.controller('Ctl', ['$scope', '$sce', function ($scope, $sce) {
        // Retrieve URLs from the model and encode them for safe use in the URL
        var motherUrl = '@Model.MOTHERURL';
        var folderUrl ='@Model.FOLDERURL';
        var otherUrl = '@Model.OTHERURL';

        // Username and password for the report server (encoded for URL use)
        var username = 'Dummy_String';
        var password = 'Dummy_String';

        // Construct the proxy URL, embedding the credentials and other URL parameters
        $scope.iframeUrl = $sce.trustAsResourceUrl('/proxy?motherUrl=' + encodeURIComponent(motherUrl) +
            '&folderUrl=' + encodeURIComponent(folderUrl) +
            '&otherUrl=' + encodeURIComponent(otherUrl) + 
            '&Log In Name=' + encodeURIComponent(username) +
            '&Password=' + encodeURIComponent(password));

        // Set the iframe URL with the trusted, encoded proxy URL
     //   $scope.iframeUrl = $sce.trustAsResourceUrl(proxyUrl);
    }]);
</script>



