<script src="~/CustomJS/DocumentSetup/DocumentApproval.js"></script>
<script src="~/customjs/common.js"></script>


<div ng-app="App" ng-controller="Ctl">
    <div ng-show="loading">
        <img style="width:70%;height:100%;position:absolute;z-index:1;" src="~/assets/images/Untitled.svg">
    </div>
    <div class="row table-responsive">
        <div class="col-sm-12">
            <div class="card">
                <div class="card-header">
                    <h4>Document Information</h4>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-sm-4">
                            <table width="100%">
                                <tr>
                                    <td style="width:100px"><label for="horizontal-email-input">Document List :</label></td>
                                    <td>
                                        <select class="form-control" ng-model="rootdoclistid" ng-init="GetRootDocumentList()" ng-change="LoadDocByPickPackNumber()"
                                                id="rootdoclistid">
                                            <option value="">--Select--</option>
                                            <option ng-repeat="list in rootdoclist" value="{{list.id}}">
                                                {{list.name}}
                                            </option>
                                        </select>
                                    </td>
                                </tr>
                            </table>
                        </div>
                        <div class="col-sm-4">

                            <table width="100%">
                                <tr>
                                    <td style="width:100px"><label for="horizontal-email-input">Document List :</label></td>
                                    <td>
                                        <select class="statusid form-control" ng-model="statusid" ng-init="StatusList()" ng-change="GetAllData()"
                                                id="statusid">
                                            <option value="">--Select--</option>
                                            <option ng-repeat="list in statuslist" value="{{list.code}}">
                                                {{list.name}}
                                            </option>
                                        </select>
                                    </td>
                                </tr>
                            </table>
                        </div>
                        <div class="col-sm-4">
                            <table width="100%">
                                <tr>
                                    <td style="width:90px"> <label>Search :</label></td>
                                    <td>
                                        <input type="text" ng-model="search" class="form-control" placeholder="Search.." />
                                    </td>
                                </tr>

                            </table>
                        </div>
                    </div><br />

                    <div class="row table-responsive">
                        <div class="col-sm-12">
                            <table id="tblinfo" class="table table-bordered">
                                <tr>
                                    <th style="display:none;">ID</th>
                                    <th ng-click='sortBy("PINUMBER")'>
                                        Doc Number
                                        <span ng-show="sortColumn=='DOCNUMBER'" ng-class="{'fa fa-angle-double-down' : !reverse, 'fa fa-angle-double-up' : reverse}"></span>
                                    </th>
                                    <th ng-click='sortBy("PICKPACKNUMBER")'>
                                        Pick Pack Number
                                        <span ng-show="sortColumn=='PICKPACKNUMBER'" ng-class="{'fa fa-angle-double-down' : !reverse, 'fa fa-angle-double-up' : reverse}"></span>
                                    </th>
                                    <th ng-click='sortBy("CUSTOMERNAME")'>
                                        Customer Name
                                        <span ng-show="sortColumn=='CUSTOMERNAME'" ng-class="{'fa fa-angle-double-down' : !reverse, 'fa fa-angle-double-up' : reverse}"></span>
                                    </th>
                                    <th ng-click='sortBy("DOCDATE")'>
                                        Document Date
                                        <span ng-show="sortColumn=='DOCDATE'" ng-class="{'fa fa-angle-double-down' : !reverse, 'fa fa-angle-double-up' : reverse}"></span>
                                    </th>
                                    <th ng-click='sortBy("DOCSTATUSNAME")'>
                                        Status
                                        <span ng-show="sortColumn=='DOCSTATUSNAME'" ng-class="{'fa fa-angle-double-down' : !reverse, 'fa fa-angle-double-up' : reverse}"></span>
                                    </th>
                                    <th>Remarks</th>
                                    <th>Action</th>
                                </tr>
                                <tr dir-paginate="list in getalldata | orderBy: sortColumn : reverse | filter:search | itemsPerPage:8">

                                    <td style="display:none;">{{list.id}}</td>
                                    <td>{{list.docnumber}}</td>
                                    <td>{{list.pickpacknumber}}</td>
                                    <td>{{list.cusname}}</td>
                                    <td>{{list.docdate}}</td>
                                    <td>
                                        <span class="badge rounded-pill badge-soft-info font-size-11" ng-if='list.code=="PEND"'>{{list.docstatusname}}</span>
                                        <span class="badge rounded-pill badge-soft-success font-size-11" ng-if='list.code=="APPR"'>{{list.docstatusname}}</span>
                                        <span class="badge rounded-pill badge-soft-danger font-size-11" ng-if='list.code=="REJC"'>{{list.docstatusname}}</span>
                                        <span class="badge rounded-pill badge-soft-primary font-size-11" ng-if='list.code=="COMP"'>{{list.docstatusname}}</span>
                                    </td>
                                    <td><input type="text" class="form-control" id="{{'description'+$index}}" /></td>
                                    <td>
                                        <button type="button" class="btn btn-info btn-sm edit" data-bs-toggle="modal" data-bs-target="#ViewEditexampleModalFullscreen" ng-click="ViewByMasterID(list.id,list.docheaderid,list.docnumber,list.pickpacknumber,list.pickingpackingheaderid)"><span class="fas fa-search-plus"></span></button>
                                        <button ng-disabled='list.code!="PEND"' type="button" class="btn btn-danger btn-sm delete" ng-click="Rejected(list.id,$index)"><span class="fas fa-times"></span></button>
                                        <button ng-disabled='list.code!="PEND"' type="button" class="btn btn-success btn-sm" ng-click="Approved(list.id,$index)"><span class="fa fa-check"></span></button>
                                    </td>
                             
                            </table>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-sm-4">
                        </div>
                        <div class="col-sm-6">
                            <dir-pagination-controls max-size="10" style="font-size:16px;"
                                                     direction-links="true"
                                                     boundary-links="true">
                            </dir-pagination-controls>

                        </div>
                        <div class="col-sm-2">
                        </div>

                    </div>


                </div>
            </div>
        </div>
    </div>


    <div id="ViewEditexampleModalFullscreen" class="modal fade" tabindex="-1" aria-labelledby="EditexampleModalFullscreenLabel" aria-hidden="true">
        <div class="modal-dialog modal-fullscreen">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="myExtraLargeModalLabel">Document (View Mode)</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form class="needs-validation" novalidate>
                        <div class="row">
                            <div class="col-sm-12">
                                <div class="card">

                                    <div class="card-header">
                                        <h6>Agreement Information</h6>
                                    </div>

                                    <div class="card-body">
                                        <table id="tblview" ng-repeat="list in masterdata" class="table table-bordered" style="font-weight:bold">
                                            <tr>
                                                <td style="text-align:right">Document Number :</td>
                                                <td style="text-align:left">{{list.docnumber}}</td>
                                                <td style="text-align:right">Pick Pack Number</td>
                                                <td style="text-align:left">{{list.pickpacknumber}}</td>
                                                <td style="text-align:right">Customer Name :</td>
                                                <td style="text-align:left">{{list.cusname}}</td>
                                            </tr>
                                            <tr>
                                                <td style="text-align:right">Document Date :</td>
                                                <td style="text-align:left">{{list.docdate}}</td>
                                                <td style="text-align:right">Terms & Condition</td>
                                                <td style="text-align:left">{{list.termscondition}}</td>
                                            </tr>
                                            <tr>
                                                <td style="text-align:right">Descriptions :</td>
                                                <td style="text-align:left">{{list.descriptions}}</td>
                                                <td style="text-align:right">Document Created Date</td>
                                                <td style="text-align:left">{{list.documentcreateddate}}</td>
                                            </tr>
                                        </table>
                                    </div>
                                </div>
                            </div>

                        </div>
