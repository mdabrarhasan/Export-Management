<script src="~/customjs/PriceConfirm/PriceConfirm.js"></script>
<script src="~/customjs/common.js"></script>
<link href="~/customcss/print.css" rel="stylesheet" />

<div ng-app="App" ng-controller="Ctl">

    <div ng-show="loading">
        <img style="width:50%;height:100%;position:absolute;z-index:1;" src="~/assets/images/Untitled.svg">
    </div>


    <div class="row">
        <div class="col-sm-12">
            <div class="card">
                <div class="card-header">
                    <h4>Price Confirmation</h4>
                </div>
                <div class="card-body" style="font-family:'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; font-size:14px;">
                    <div class="row">
                        <!-- Add Button -->
                        <div class="col-md-4 d-flex align-items-center">
                            <button type="button"
                                    class="btn btn-primary btn-sm d-inline-flex align-items-center gap-2 px-3 py-2 shadow-sm"
                                    ng-click="Clear()"
                                    data-bs-toggle="modal"
                                    data-bs-target="#exampleModalFullscreen">
                                <b>
                                    <i class="mdi mdi-plus"></i>
                                    <span>Add New</span>
                                </b>
                            </button>
                        </div>

                        <!-- Business Unit -->
                        <div class="col-md-4">
                            <label class="mb-1">Business Unit</label>
                            <select class="form-control" ng-model="unitid" ng-init="GetUnit()" ng-change="PCList()"
                                    id="unitid">
                                <option value="">--Select--</option>
                                <option ng-repeat="list in unitlist" value="{{list.id}}">
                                    {{list.name}}
                                </option>
                            </select>
                        </div>

                        <!-- Search -->
                        <div class="col-md-4">
                            <label class="mb-1">Search</label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="mdi mdi-magnify"></i>
                                </span>

                                <input type="text"
                                       ng-model="search"
                                       class="form-control"
                                       placeholder="Search by PC No, Customer, Seller...">

                                <button class="btn btn-outline-secondary"
                                        type="button"
                                        ng-click="search=''"
                                        ng-show="search">
                                    <i class="mdi mdi-close"></i>
                                </button>
                            </div>
                        </div>

                    </div><br />

                    <div class="table-responsive">
                        <table class="table table-bordered table-hover" id="tblinfo">
                            <thead>
                                <tr>
                                    <th style="display:none;">ID</th>

                                    <th ng-click='sortBy("pcnumber")'>
                                        Price Con. Number
                                        <span ng-show="sortColumn=='pcnumber'"
                                              ng-class="{'fa fa-angle-double-down': !reverse, 'fa fa-angle-double-up': reverse}">
                                        </span>
                                    </th>

                                    <th ng-click='sortBy("sqnumber")'>
                                        Number
                                        <span ng-show="sortColumn=='sqnumber'"
                                              ng-class="{'fa fa-angle-double-down': !reverse, 'fa fa-angle-double-up': reverse}">
                                        </span>
                                    </th>

                                    <th ng-click='sortBy("agreementtype")'>
                                        Type
                                        <span ng-show="sortColumn=='agreementtype'"
                                              ng-class="{'fa fa-angle-double-down': !reverse, 'fa fa-angle-double-up': reverse}">
                                        </span>
                                    </th>

                                    <th ng-click='sortBy("documentcreateddate")'>
                                        Quotation Date
                                        <span ng-show="sortColumn=='documentcreateddate'"
                                              ng-class="{'fa fa-angle-double-down': !reverse, 'fa fa-angle-double-up': reverse}">
                                        </span>
                                    </th>

                                    <th ng-click='sortBy("cusname")'>
                                        Customer Name
                                        <span ng-show="sortColumn=='cusname'"
                                              ng-class="{'fa fa-angle-double-down': !reverse, 'fa fa-angle-double-up': reverse}">
                                        </span>
                                    </th>

                                    <th ng-click='sortBy("sellername")'>
                                        Seller Name
                                        <span ng-show="sortColumn=='sellername'"
                                              ng-class="{'fa fa-angle-double-down': !reverse, 'fa fa-angle-double-up': reverse}">
                                        </span>
                                    </th>

                                    <th ng-click='sortBy("currency")'>
                                        Currency
                                        <span ng-show="sortColumn=='currency'"
                                              ng-class="{'fa fa-angle-double-down': !reverse, 'fa fa-angle-double-up': reverse}">
                                        </span>
                                    </th>

                                    <th ng-click='sortBy("docstatus")'>
                                        Status
                                        <span ng-show="sortColumn=='docstatus'"
                                              ng-class="{'fa fa-angle-double-down': !reverse, 'fa fa-angle-double-up': reverse}">
                                        </span>
                                    </th>

                                    <th>Remarks</th>
                                    <th>Action</th>
                                </tr>
                            </thead>

                            <tbody>
                                <tr dir-paginate="list in PClist | orderBy:sortColumn:reverse | filter:search | itemsPerPage:8">
                                    <td style="display:none;">{{list.id}}</td>
                                    <td>{{list.pcnumber}}</td>
                                    <td>{{list.sqnumber}}</td>
                                    <td>{{list.agreementtype}}</td>
                                    <td>{{list.documentcreateddate}}</td>
                                    <td>{{list.cusname}}</td>
                                    <td>{{list.sellername}}</td>
                                    <td>{{list.currency}}</td>

                                    <td>
                                        <span class="badge rounded-pill badge-soft-info font-size-11" ng-if='list.code=="PEND"'>{{list.docstatus}}</span>
                                        <span class="badge rounded-pill badge-soft-success font-size-11" ng-if='list.code=="APPR"'>{{list.docstatus}}</span>
                                        <span class="badge rounded-pill badge-soft-danger font-size-11" ng-if='list.code=="REJC"'>{{list.docstatus}}</span>
                                        <span class="badge rounded-pill badge-soft-primary font-size-11" ng-if='list.code=="COMP"'>{{list.docstatus}}</span>
                                    </td>

                                    <td>{{list.descriptions}}</td>

                                    <td>
                                        <button type="button" class="btn btn-info btn-sm"
                                                data-bs-toggle="modal"
                                                data-bs-target="#ViewEditexampleModalFullscreen"
                                                ng-click="ViewCData(list.id,list.proformainvoiceheaderid)">
                                            <span class="fas fa-search-plus"></span>
                                        </button>

                                        <button type="button" class="btn btn-info btn-sm"
                                                ng-disabled='list.code=="COMP"'
                                                data-bs-toggle="modal"
                                                data-bs-target="#EditexampleModalFullscreen"
                                                ng-click="EditbyMasterID(list.id,list.customerid,list.unitid,list.number,list.descriptions,list.termscondition)">
                                            <span class="fa fa-edit"></span>
                                        </button>

                                        <button type="button" class="btn btn-danger btn-sm"
                                                ng-disabled='list.flag == 1'
                                                ng-click="DeleteMaster(list.id)">
                                            <span class="fa fa-trash"></span>
                                        </button>

                                        <button type="button" class="btn btn-soft-primary btn-sm"
                                                ng-if="list.unitid == 91"
                                                data-bs-toggle="modal"
                                                data-bs-target="#PrintexampleModalFullscreen"
                                                ng-click="Print(list.id)">
                                            <span class="fas fa-print"></span>
                                        </button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                    </div>

                    <!-- Pagination Init -->
                    <div ng-init="currentPage=1; pageSize=8"></div>

                    <!-- Pagination Style -->
                    <style>
                        dir-pagination-controls ul {
                            display: flex;
                            justify-content: center;
                            gap: 6px;
                            margin-top: 20px;
                            padding-left: 0;
                        }

                        dir-pagination-controls li {
                            list-style: none;
                        }

                            dir-pagination-controls li a {
                                padding: 8px 14px;
                                border-radius: 8px;
                                background: #f8f9fa;
                                color: #0d6efd;
                                font-weight: 500;
                                transition: 0.25s;
                            }

                            dir-pagination-controls li.active a {
                                background: #0d6efd;
                                color: #fff;
                            }

                            dir-pagination-controls li a:hover {
                                background: #e7f1ff;
                            }
                    </style>

                    <!-- Bottom Section -->
                    <div class="row mt-2 align-items-center">

                        <!-- Total -->
                        <div class="col-md-4">
                            <span style="font-size:13px; font-weight:600; opacity:0.75;">
                                Total Records:
                                <b>{{ (PClist | filter:search).length }}</b>
                            </span>
                        </div>

                        <!-- Pagination -->
                        <div class="col-md-4 text-center">
                            <dir-pagination-controls direction-links="true"
                                                     boundary-links="true"
                                                     max-size="10"
                                                     current-page="currentPage">
                            </dir-pagination-controls>
                        </div>

                        <div class="col-md-4"></div>

                    </div>

                </div>
            </div>
        </div>

    </div>

