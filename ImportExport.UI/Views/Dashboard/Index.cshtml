    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
    <script>
        $(document).ready(function () {
           
            $.ajax({
                type: "GET",
                url: "Dashboard/GetDashboardvalue",
                
                dataType: "json",
                success: function (response) {
                    console.log(response)
                  
                    $('.sqp').text(response[0].sqp);
                    $('.sqc').text(response[0].sqc);
                    $('.sqr').text(response[0].sqr);
                    $('.sqt').text(response[0].sqr + response[0].sqc + response[0].sqp);
                    $('.pip').text(response[0].pip);
                    $('.pic').text(response[0].pic);
                    $('.pir').text(response[0].pir );
                    $('.pit').text(response[0].pir + response[0].pip + response[0].pic);
                    $('.scp').text(response[0].scp);
                    $('.scc').text(response[0].scc);
                    $('.scr').text(response[0].scr);
                    $('.sct').text(response[0].scr + response[0].scc + response[0].scp);
                    $('.lcp').text(response[0].lcp);
                    $('.lcc').text(response[0].lcc);
                    $('.lcr').text(response[0].lcr);
                    $('.lct').text(response[0].lcr + response[0].lcc + response[0].lcp);
                    $('.pcp').text(response[0].pcp);
                    $('.pcc').text(response[0].pcc);
                    $('.pcr').text(response[0].pcr);
                    $('.pct').text(response[0].pcr + response[0].pcp + response[0].pcc);
                    $('.prc').text(response[0].prc);
                    $('.prp').text(response[0].prp);
                    $('.prr').text(response[0].prr);
                    $('.prt').text(response[0].prr + response[0].prc + response[0].prp);
                    $('.ppc').text(response[0].ppc);
                    $('.ppp').text(response[0].ppp);
                    $('.ppr').text(response[0].ppr);
                    $('.ppt').text(response[0].ppr + response[0].ppp + response[0].ppc);
                },
                error: function (xhr, textStatus, errorThrown) {
                    alert("Error: " + errorThrown); 
                },
                data: JSON.stringify({ /* Include any data you need to send to the server */ })
            });
        });
    </script>
